<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Tema Escuro (paleta Fiery Red Sunset): fundo Ink Black, cards de metal noturno (degradê de cima
  para baixo e aresta com brilho em cima) e um brilho de brasa atrás do conteúdo, em Oxblood,
  Cayenne e açafrão.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="ComponentVault.Lib.Resources.Theme.DarkPalette">

    <Color x:Key="Ink">#F6EFEA</Color>
    <Color x:Key="InkHover">#E2D8D2</Color>
    <Color x:Key="OnInk">#03071E</Color>
    <Color x:Key="InkSecondary">#B6ADAA</Color>
    <Color x:Key="InkTertiary">#8E8789</Color>

    <Color x:Key="Ground">#03071E</Color>
    <Color x:Key="Surface">#0B0F27</Color>
    <Color x:Key="SurfaceRaised">#131731</Color>
    <!-- Mais claro que o topo do CardFill, senão os selos e chips somem dentro dos cards -->
    <Color x:Key="SurfaceAlt">#1D2142</Color>
    <Color x:Key="SurfaceHover">#262A4E</Color>
    <Color x:Key="Hairline">#1E2240</Color>
    <Color x:Key="HairlineStrong">#2E3254</Color>
    <!-- Campo preenchido: tom mais fundo que o card, contorno discreto -->
    <Color x:Key="FieldFill">#0A0E26</Color>
    <Color x:Key="FieldStroke">#2A2E50</Color>
    <!-- Metal noturno: um pouco mais claro em cima -->
    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#151935" Offset="0" />
        <GradientStop Color="#0E122B" Offset="0.6" />
        <GradientStop Color="#0A0D24" Offset="1" />
    </LinearGradientBrush>
    <!-- Aresta metálica com reflexo quente em cima, quase some embaixo -->
    <LinearGradientBrush x:Key="CardStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5E4A55" Offset="0" />
        <GradientStop Color="#2C2D4C" Offset="0.4" />
        <GradientStop Color="#161A36" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="Chrome">#F20B0F27</Color>
    <Color x:Key="ChromeStroke">#2E3254</Color>

    <!-- Texto em destaque: Orange (contraste alto sobre o Ink Black) -->
    <Color x:Key="AccentText">#FAA307</Color>
    <Color x:Key="AccentTint">#33E85D04</Color>
    <Color x:Key="SuccessText">#4CC38A</Color>
    <Color x:Key="WarningText">#FFBA08</Color>
    <Color x:Key="DangerText">#FF6B5E</Color>
    <Color x:Key="SuccessTint">#0F2421</Color>
    <Color x:Key="WarningTint">#2A1E0A</Color>
    <Color x:Key="DangerTint">#2A0A10</Color>
    <Color x:Key="InfoTint">#121B3A</Color>

    <Color x:Key="SyntaxPlain">#EDE6E1</Color>
    <Color x:Key="SyntaxKeyword">#FAA307</Color>
    <Color x:Key="SyntaxType">#55C7BF</Color>
    <Color x:Key="SyntaxString">#6CCB97</Color>
    <Color x:Key="SyntaxNumber">#FFBA08</Color>
    <Color x:Key="SyntaxComment">#6E7290</Color>
    <Color x:Key="SyntaxElement">#F48C06</Color>
    <Color x:Key="SyntaxAttribute">#FF8B6E</Color>
    <Color x:Key="SyntaxPunctuation">#7F8299</Color>

    <!-- Brilho de brasa: Oxblood, Cayenne e açafrão sobre o Ink Black -->
    <RadialGradientBrush x:Key="AmbientBlue" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#559D0208" Offset="0" />
        <GradientStop Color="#1C9D0208" Offset="0.5" />
        <GradientStop Color="#009D0208" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientTeal" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#40E85D04" Offset="0" />
        <GradientStop Color="#14E85D04" Offset="0.5" />
        <GradientStop Color="#00E85D04" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientRose" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#2EF48C06" Offset="0" />
        <GradientStop Color="#0EF48C06" Offset="0.5" />
        <GradientStop Color="#00F48C06" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
