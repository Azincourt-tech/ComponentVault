<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Ponto de entrada do design system. O app faz merge de <lib:VaultTheme /> no App.xaml.
  Todos os estilos são NOMEADOS (com x:Key), nunca implícitos: assim as variantes "Base MAUI"
  continuam mostrando o controle cru, sem herdar nada daqui.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                    x:Class="ComponentVault.Lib.Resources.Theme.VaultTheme">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Página ===== -->

    <Style x:Key="VaultPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource Ground}" />
    </Style>

    <!-- ===== Tipografia (Plus Jakarta Sans, sentence case, corpo 16) ===== -->

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource TextHeadline}" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource TextCardTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="LineHeight" Value="1.45" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="BodyMuted" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="TextColor" Value="{DynamicResource InkSecondary}" />
    </Style>

    <Style x:Key="BodySmall" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{DynamicResource InkSecondary}" />
    </Style>

    <!-- Rótulo de campo e de grupo: 13, peso 500, sentence case (sem maiúsculas espaçadas) -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="TextColor" Value="{DynamicResource InkSecondary}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="TextColor" Value="{DynamicResource InkTertiary}" />
    </Style>

    <Style x:Key="CodeText" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextCode}" />
        <Setter Property="LineHeight" Value="1.55" />
        <Setter Property="TextColor" Value="{DynamicResource SyntaxPlain}" />
    </Style>

    <!-- ===== Botões =====
         Um primário cheio (tinta) por tela; secundário com linha fina; terciário só texto.
         Press: encolhe para .985 e desce 1px, sem bounce. -->

    <!-- snippet:styles.button -->
    <Style x:Key="VaultButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchButton}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource VaultButtonBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="TextColor" Value="{DynamicResource OnInk}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource InkHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource InkHover}" />
                            <Setter Property="Scale" Value="0.985" />
                            <Setter Property="TranslationY" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource VaultButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentHover}" />
                            <Setter Property="Scale" Value="0.985" />
                            <Setter Property="TranslationY" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource VaultButtonBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BorderColor" Value="{DynamicResource HairlineStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceHover}" />
                            <Setter Property="Scale" Value="0.985" />
                            <Setter Property="TranslationY" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="TertiaryButton" TargetType="Button" BasedOn="{StaticResource VaultButtonBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentTint}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentTint}" />
                            <Setter Property="Scale" Value="0.985" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource VaultButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DangerHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DangerHover}" />
                            <Setter Property="Scale" Value="0.985" />
                            <Setter Property="TranslationY" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonLarge" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="24,13" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchInput}" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <Style x:Key="PrimaryButtonSmall" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style x:Key="SecondaryButtonSmall" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <!-- /snippet:styles.button -->

    <!-- ===== Controles nativos estilizados ===== -->

    <!-- snippet:styles.controls -->
    <Style x:Key="VaultSwitch" TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Accent}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>

    <Style x:Key="VaultCheckBox" TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Accent}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchButton}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchButton}" />
    </Style>

    <Style x:Key="VaultSlider" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource Accent}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource HairlineStrong}" />
        <Setter Property="ThumbColor" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="VaultProgressBar" TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Accent}" />
        <Setter Property="HeightRequest" Value="6" />
    </Style>

    <Style x:Key="VaultActivityIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Ink}" />
        <Setter Property="WidthRequest" Value="22" />
        <Setter Property="HeightRequest" Value="22" />
    </Style>

    <!-- Campo "nu" para usar dentro de VaultField (a borda vem do container). -->
    <Style x:Key="BareEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkTertiary}" />
    </Style>

    <Style x:Key="BareEditor" TargetType="Editor">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkTertiary}" />
    </Style>

    <Style x:Key="VaultPicker" TargetType="Picker">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="TitleColor" Value="{DynamicResource InkTertiary}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchInput}" />
    </Style>

    <!-- Moldura de campo: superfície, linha forte, raio 10, 48px. -->
    <Style x:Key="FieldFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="Stroke" Value="{DynamicResource HairlineStrong}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchInput}" />
    </Style>
    <!-- /snippet:styles.controls -->

    <!-- ===== Superfícies ===== -->

    <!-- snippet:styles.card -->
    <!-- Card: linha fina, sem sombra. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource CardStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Card clicável: no hover a borda escurece e o card sobe 2px. -->
    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{DynamicResource HairlineStrong}" />
                            <Setter Property="TranslationY" Value="-2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Linha de lista com toque: realce de fundo no hover. -->
    <Style x:Key="ListRow" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource Hairline}" />
    </Style>
    <!-- /snippet:styles.card -->

    <!-- Tela onde o componente é exibido. -->
    <Style x:Key="PreviewCanvas" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource CardStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>

    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="TagText" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="TextColor" Value="{DynamicResource InkSecondary}" />
    </Style>

</ResourceDictionary>
