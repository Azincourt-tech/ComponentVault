<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Tema Vidro (inspirado no Liquid Glass da Apple): fundo profundo com manchas de luz vivas e
  superfícies translúcidas com brilho na borda superior. Sem desfoque real no MAUI multiplataforma,
  é a translucidez sobre luz difusa que dá a leitura de vidro. Os controles nativos ficam no modo escuro.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="ComponentVault.Lib.Resources.Theme.GlassPalette">

    <Color x:Key="Ink">#F5F7FC</Color>
    <Color x:Key="InkHover">#DCE2EF</Color>
    <Color x:Key="OnInk">#0A0E1C</Color>
    <Color x:Key="InkSecondary">#BAC3D8</Color>
    <Color x:Key="InkTertiary">#909BB6</Color>

    <Color x:Key="Ground">#070A16</Color>
    <!-- Vidro: branco com pouca opacidade sobre o fundo de luz -->
    <Color x:Key="Surface">#17FFFFFF</Color>
    <Color x:Key="SurfaceRaised">#24FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#12FFFFFF</Color>
    <Color x:Key="SurfaceHover">#2BFFFFFF</Color>
    <Color x:Key="Hairline">#1FFFFFFF</Color>
    <Color x:Key="HairlineStrong">#38FFFFFF</Color>
    <!-- Borda com brilho em cima e quase nada embaixo: a "aresta" do vidro -->
    <LinearGradientBrush x:Key="CardStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.35" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="AccentText">#A3C4FF</Color>
    <Color x:Key="AccentTint">#3D4F8EF7</Color>
    <Color x:Key="SuccessText">#7BE8B8</Color>
    <Color x:Key="WarningText">#FFD27A</Color>
    <Color x:Key="DangerText">#FFA3A3</Color>
    <Color x:Key="SuccessTint">#2934D399</Color>
    <Color x:Key="WarningTint">#29FBBF24</Color>
    <Color x:Key="DangerTint">#29F87171</Color>
    <Color x:Key="InfoTint">#294F8EF7</Color>

    <Color x:Key="SyntaxPlain">#EEF1F8</Color>
    <Color x:Key="SyntaxKeyword">#93B8FF</Color>
    <Color x:Key="SyntaxType">#6FE3D6</Color>
    <Color x:Key="SyntaxString">#8AE6B0</Color>
    <Color x:Key="SyntaxNumber">#FFB487</Color>
    <Color x:Key="SyntaxComment">#7F8AA6</Color>
    <Color x:Key="SyntaxElement">#93B8FF</Color>
    <Color x:Key="SyntaxAttribute">#FF9EBB</Color>
    <Color x:Key="SyntaxPunctuation">#8A95AF</Color>

    <!-- Luz ambiente: azul, verde-água e rosa (sem violeta) -->
    <RadialGradientBrush x:Key="AmbientBlue" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#B32F6FE4" Offset="0" />
        <GradientStop Color="#402F6FE4" Offset="0.5" />
        <GradientStop Color="#002F6FE4" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientTeal" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#9914B8A6" Offset="0" />
        <GradientStop Color="#3314B8A6" Offset="0.5" />
        <GradientStop Color="#0014B8A6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientRose" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#8CF0527E" Offset="0" />
        <GradientStop Color="#2EF0527E" Offset="0.5" />
        <GradientStop Color="#00F0527E" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
