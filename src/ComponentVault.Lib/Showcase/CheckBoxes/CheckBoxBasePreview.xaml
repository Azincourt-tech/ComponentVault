<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.CheckBoxes.CheckBoxBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:checkbox.base -->
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="4">
                    <CheckBox x:Name="TermsCheck" />
                    <Label Text="Aceito os termos de uso" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="True" />
                    <Label Text="Receber novidades" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="True" IsEnabled="False" />
                    <Label Text="Desabilitado" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <!-- /snippet:checkbox.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="O CheckBox não tem texto próprio: o rótulo é um Label ao lado que não responde ao toque. Também não existe o estado indeterminado." />

    </VerticalStackLayout>

</ContentView>
