<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Chips.ChipsBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Escolha com RadioButton" />
            <!-- snippet:chips.base -->
            <FlexLayout Wrap="Wrap" RadioButtonGroup.GroupName="ChipsBase">
                <RadioButton Content="Todos" IsChecked="True" />
                <RadioButton Content="Nativos" />
                <RadioButton Content="Custom" />
                <RadioButton Content="Bibliotecas" />
            </FlexLayout>
            <!-- /snippet:chips.base -->
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Filtro com CheckBox" />
            <!-- snippet:chips.base.filter -->
            <FlexLayout Wrap="Wrap">
                <HorizontalStackLayout Margin="0,0,16,0">
                    <CheckBox IsChecked="True" />
                    <Label Text="Android" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,16,0">
                    <CheckBox IsChecked="True" />
                    <Label Text="Windows" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,0,16,0">
                    <CheckBox />
                    <Label Text="iOS" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </FlexLayout>
            <!-- /snippet:chips.base.filter -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="O MAUI não tem chips. O mais perto é RadioButton para escolher um e CheckBox para filtrar vários: funcionam e são acessíveis, mas ocupam mais espaço e nada lembra um chip. O CheckBox não tem texto, e no Windows ele reserva cerca de 120px de largura: o rótulo montado ao lado fica longe da caixa." />

    </VerticalStackLayout>

</ContentView>
