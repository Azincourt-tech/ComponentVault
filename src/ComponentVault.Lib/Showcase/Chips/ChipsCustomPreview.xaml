<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chips="clr-namespace:ComponentVault.Lib.Showcase.Chips"
             x:Class="ComponentVault.Lib.Showcase.Chips.ChipsCustomPreview">

    <VerticalStackLayout Spacing="28">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Escolha: a pílula desliza até o chip tocado" />
            <!-- snippet:chips.custom -->
            <chips:ChoiceChipGroup SelectedIndex="0">
                <chips:ChoiceChipGroup.Options>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Todos</x:String>
                        <x:String>Nativos</x:String>
                        <x:String>Custom</x:String>
                        <x:String>Bibliotecas</x:String>
                    </x:Array>
                </chips:ChoiceChipGroup.Options>
            </chips:ChoiceChipGroup>
            <!-- /snippet:chips.custom -->
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Filtro: o check entra com animação" />
            <!-- snippet:chips.custom.filter -->
            <FlexLayout Wrap="Wrap">
                <chips:FilterChip Text="Android" IsChecked="True" Margin="0,0,8,8" />
                <chips:FilterChip Text="Windows" IsChecked="True" Margin="0,0,8,8" />
                <chips:FilterChip Text="iOS" Margin="0,0,8,8" />
                <chips:FilterChip Text="Tema escuro" Margin="0,0,8,8" />
            </FlexLayout>
            <!-- /snippet:chips.custom.filter -->
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>
