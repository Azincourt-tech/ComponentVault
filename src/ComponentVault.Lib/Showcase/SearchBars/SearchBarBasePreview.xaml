<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.SearchBars.SearchBarBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:searchbar.base -->
            <SearchBar x:Name="Search"
                       Placeholder="Buscar componente"
                       SearchButtonPressed="OnSearch" />
            <!-- /snippet:searchbar.base -->
            <Label x:Name="ResultLabel" Style="{StaticResource Caption}" Text="Pressione Enter para buscar" />
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="O SearchBar traz ícone e botão de limpar nativos, mas o visual varia muito entre plataformas e a lista de sugestões fica por sua conta." />

    </VerticalStackLayout>

</ContentView>
