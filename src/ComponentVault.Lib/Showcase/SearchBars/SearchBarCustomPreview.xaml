<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.SearchBars"
             x:Class="ComponentVault.Lib.Showcase.SearchBars.SearchBarCustomPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:searchbar.custom -->
        <!--
          Cabeçalho de tela com a busca recolhida numa lupa. Tocar abre o campo na largura toda e
          mostra sugestões; digitar filtra; escolher fecha e abre o item.
        -->
        <Border Style="{StaticResource Card}" Padding="16,14">
            <VerticalStackLayout Spacing="14">

                <local:ExpandingSearch x:Name="Search" Title="Componentes" Placeholder="Buscar componente"
                                       ItemChosen="OnItemChosen" />

                <Label x:Name="ResultLabel" Style="{StaticResource BodyMuted}"
                       Text="Toque na lupa para buscar entre os 30 componentes." />

            </VerticalStackLayout>
        </Border>
        <!-- /snippet:searchbar.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="ExpandingSearch: a busca ocupa só um botão até ser chamada. O botão estica até a largura toda enquanto o título sai, e as sugestões descem em cascata. O trecho encontrado aparece em destaque, ignorando acentos e maiúsculas." />

    </VerticalStackLayout>

</ContentView>
