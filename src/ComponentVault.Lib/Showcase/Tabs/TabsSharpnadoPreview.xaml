<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fit="clr-namespace:ComponentVault.Lib.Theming"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:tabs="clr-namespace:Sharpnado.Tabs;assembly=Maui.Tabs"
             x:Class="ComponentVault.Lib.Showcase.Tabs.TabsSharpnadoPreview">

    <VerticalStackLayout Spacing="28">

        <!-- snippet:tabs.sharpnado -->
        <!-- Abas sublinhadas + ViewSwitcher: o SelectedIndex das duas peças anda junto. -->
        <VerticalStackLayout Spacing="0">
            <Label Style="{StaticResource FieldLabel}" Text="Abas sublinhadas" Margin="0,0,0,8" />
            <tabs:TabHostView x:Name="UnderlinedTabs"
                              HeightRequest="44"
                              TabType="Fixed"
                              SelectedIndex="0"
                              BackgroundColor="Transparent">
                <tabs:UnderlinedTabItem Label="Pedidos" LabelSize="15"
                                        FontFamily="{StaticResource FontSemiBold}"
                                        SelectedTabColor="{DynamicResource Ink}"
                                        UnselectedLabelColor="{DynamicResource InkSecondary}" />
                <tabs:UnderlinedTabItem Label="Devoluções" LabelSize="15"
                                        FontFamily="{StaticResource FontSemiBold}"
                                        SelectedTabColor="{DynamicResource Ink}"
                                        UnselectedLabelColor="{DynamicResource InkSecondary}" />
                <tabs:UnderlinedTabItem Label="Arquivados" LabelSize="15"
                                        FontFamily="{StaticResource FontSemiBold}"
                                        SelectedTabColor="{DynamicResource Ink}"
                                        UnselectedLabelColor="{DynamicResource InkSecondary}" />
            </tabs:TabHostView>
            <BoxView Style="{StaticResource Divider}" />
            <tabs:ViewSwitcher x:DataType="tabs:TabHostView"
                               SelectedIndex="{Binding SelectedIndex, Source={x:Reference UnderlinedTabs}}"
                               Animate="True"
                               HeightRequest="56"
                               Padding="0,16,0,0">
                <Label Style="{StaticResource BodyMuted}" Text="12 pedidos em andamento, 3 aguardando pagamento." />
                <Label Style="{StaticResource BodyMuted}" Text="Nenhuma devolução aberta nos últimos 30 dias." />
                <Label Style="{StaticResource BodyMuted}" Text="148 pedidos arquivados. Busque pelo número ou cliente." />
            </tabs:ViewSwitcher>
        </VerticalStackLayout>

        <!-- Segmentado: para alternar visões do mesmo conteúdo (dia, semana, mês). -->
        <VerticalStackLayout Spacing="8">
            <Label Style="{StaticResource FieldLabel}" Text="Controle segmentado" />
            <tabs:TabHostView x:Name="PeriodTabs"
                              HeightRequest="40"
                              TabType="Fixed"
                              IsSegmented="True"
                              CornerRadius="10"
                              SegmentedOutlineColor="{DynamicResource HairlineStrong}"
                              BackgroundColor="{DynamicResource Surface}"
                              SelectedIndex="1">
                <tabs:SegmentedTabItem Label="Dia" LabelSize="14" FontFamily="{StaticResource FontMedium}"
                                       SelectedTabColor="{DynamicResource Ink}"
                                       SelectedLabelColor="{DynamicResource OnInk}"
                                       UnselectedLabelColor="{DynamicResource InkSecondary}" />
                <tabs:SegmentedTabItem Label="Semana" LabelSize="14" FontFamily="{StaticResource FontMedium}"
                                       SelectedTabColor="{DynamicResource Ink}"
                                       SelectedLabelColor="{DynamicResource OnInk}"
                                       UnselectedLabelColor="{DynamicResource InkSecondary}" />
                <tabs:SegmentedTabItem Label="Mês" LabelSize="14" FontFamily="{StaticResource FontMedium}"
                                       SelectedTabColor="{DynamicResource Ink}"
                                       SelectedLabelColor="{DynamicResource OnInk}"
                                       UnselectedLabelColor="{DynamicResource InkSecondary}" />
            </tabs:TabHostView>
        </VerticalStackLayout>
        <!-- /snippet:tabs.sharpnado -->

    </VerticalStackLayout>

</ContentView>
