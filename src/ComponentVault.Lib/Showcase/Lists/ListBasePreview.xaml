<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Lists.ListBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="CollectionView com strings" />
            <!-- snippet:list.base -->
            <CollectionView HeightRequest="240" SelectionMode="Single">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Caixa de entrada</x:String>
                        <x:String>Enviados</x:String>
                        <x:String>Rascunhos</x:String>
                        <x:String>Arquivados</x:String>
                        <x:String>Lixeira</x:String>
                        <x:String>Spam</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" Padding="8" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!-- /snippet:list.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="A CollectionView virtualiza os itens, mas não traz separadores, altura mínima de toque nem destaque de seleção consistente entre plataformas." />

    </VerticalStackLayout>

</ContentView>
