<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.Lists"
             x:Class="ComponentVault.Lib.Showcase.Lists.ListCustomPreview"
             x:Name="Root">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:list.custom -->
        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource FieldLabel}" Text="Caixa de entrada" VerticalOptions="Center" />
                <Label x:Name="CountLabel" Grid.Column="1" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <!-- Cada linha é um cartão: arraste para a direita (arquivar) ou para a esquerda (excluir). -->
            <VerticalStackLayout x:Name="Inbox" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:InboxItem">
                        <local:SwipeRow Swiped="OnSwiped">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 19"
                                        BackgroundColor="{DynamicResource AccentTint}" VerticalOptions="Center">
                                    <Label Text="{Binding Initials}" FontFamily="{StaticResource FontSemiBold}" FontSize="13"
                                           TextColor="{DynamicResource AccentText}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource Body}" LineHeight="1" FontFamily="{StaticResource FontMedium}" Text="{Binding Sender}" />
                                    <Label Style="{StaticResource BodySmall}" Text="{Binding Subject}" MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Time}" VerticalOptions="Start" />
                            </Grid>
                        </local:SwipeRow>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Lista vazia: diz o que aconteceu e oferece trazer tudo de volta. -->
            <Border x:Name="EmptyState" IsVisible="False" Style="{StaticResource Card}" Padding="18,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Style="{StaticResource BodyMuted}" Text="Caixa de entrada vazia." VerticalOptions="Center" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonSmall}" Text="Restaurar" Clicked="OnRestoreClicked" />
                </Grid>
            </Border>

            <!-- Desfazer: a última ação pode voltar, então nada precisa de confirmação. -->
            <Border x:Name="UndoBar" IsVisible="False" Padding="16,10" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource Ink}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="UndoLabel" FontFamily="{StaticResource FontRegular}" FontSize="14"
                           TextColor="{DynamicResource OnInk}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Desfazer" Clicked="OnUndoClicked" BackgroundColor="Transparent"
                            TextColor="{DynamicResource OnInk}" FontFamily="{StaticResource FontSemiBold}" FontSize="14"
                            Padding="12,6" MinimumHeightRequest="36" />
                </Grid>
            </Border>

        </VerticalStackLayout>
        <!-- /snippet:list.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="SwipeRow: o fundo é desenhado e muda no limiar: um círculo de cor cresce a partir do ícone para avisar que soltar confirma. A linha sai pela borda e a altura se fecha antes de o item sair da lista. No Windows, o botão direito oferece as mesmas ações." />

    </VerticalStackLayout>

</ContentView>
