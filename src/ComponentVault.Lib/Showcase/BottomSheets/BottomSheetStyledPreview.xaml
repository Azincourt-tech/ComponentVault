<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.BottomSheets"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             xmlns:fit="clr-namespace:ComponentVault.Lib.Theming"
             x:Class="ComponentVault.Lib.Showcase.BottomSheets.BottomSheetStyledPreview">

    <VerticalStackLayout Spacing="24">

        <Border fit:Fit.MaxWidth="380" HeightRequest="460" StrokeThickness="1" StrokeShape="RoundRectangle 28"
                Stroke="{DynamicResource HairlineStrong}" Padding="0">
            <!-- snippet:bottomsheet.styled -->
            <Grid IsClippedToBounds="True">
                <local:MapBackdrop />
                <Button Text="Ver rota" Style="{StaticResource PrimaryButtonSmall}" HorizontalOptions="Start" VerticalOptions="Start"
                        Margin="16" Clicked="OnOpenClicked" />

                <!-- Fundo que escurece: tocar fora fecha. -->
                <BoxView x:Name="Scrim" Color="Black" Opacity="0" IsVisible="False">
                    <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseTapped" /></BoxView.GestureRecognizers>
                </BoxView>

                <!-- Folha com alça, cantos de cima arredondados e tokens; sobe da borda em 260ms. -->
                <Border x:Name="Sheet" IsVisible="False" VerticalOptions="End" Padding="20,0,20,20"
                        StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0"
                        BackgroundColor="{DynamicResource SurfaceRaised}" Stroke="{DynamicResource Hairline}">
                    <VerticalStackLayout Spacing="14">
                        <Border WidthRequest="40" HeightRequest="5" StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                BackgroundColor="{DynamicResource HairlineStrong}" HorizontalOptions="Center" Margin="0,10,0,0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource SectionHeader}" Text="18 min" />
                                <Label Style="{StaticResource BodySmall}" Text="6,2 km · chegada às 09:42 · trânsito leve" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource AccentTint}" VerticalOptions="Center">
                                <mic:MauiIcon Icon="{mi:Fluent Icon=VehicleCar20}" IconSize="20" IconColor="{DynamicResource AccentText}"
                                              HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Fechar" Style="{StaticResource SecondaryButton}" Clicked="OnCloseClicked" />
                            <Button Grid.Column="1" Text="Iniciar" Style="{StaticResource PrimaryButton}" Clicked="OnCloseClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <!-- /snippet:bottomsheet.styled -->
        </Border>

        <Label Style="{StaticResource BodySmall}"
               Text="O mesmo Border do Base com os tokens do design system: alça, cantos de cima arredondados, fundo que escurece e fecha ao tocar, e a folha subindo da borda com TranslateTo. Não arrasta: os pontos de parada ficam para o Custom." />

    </VerticalStackLayout>

</ContentView>
