<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Avatars.AvatarBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Border + Label" />
            <!-- snippet:avatar.base -->
            <HorizontalStackLayout Spacing="12">
                <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" BackgroundColor="LightGray">
                    <Label Text="WA" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border WidthRequest="48" HeightRequest="48" StrokeShape="Ellipse" BackgroundColor="SteelBlue">
                    <Label Text="AR" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
            <!-- /snippet:avatar.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="Funciona, mas cada tamanho exige recalcular raio e fonte à mão, e não há fallback de imagem para iniciais." />

    </VerticalStackLayout>

</ContentView>
