<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.Avatars"
             x:Class="ComponentVault.Lib.Showcase.Avatars.AvatarCustomPreview">

    <ContentView.Resources>
        <Style x:Key="StoryName" TargetType="Label">
            <Setter Property="FontFamily" Value="JakartaRegular" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{DynamicResource InkSecondary}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="24">

        <!-- snippet:avatar.custom -->
        <VerticalStackLayout Spacing="22">

            <!-- Stories: anel em degradê = novidade; cinza fino = já visto. Os novos vêm primeiro. -->
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource FieldLabel}" Text="Stories" />
                <HorizontalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="6">
                        <local:StoryAvatar Initials="AS" Ring="New" FaceColor="#E85D04" />
                        <Label Style="{StaticResource StoryName}" Text="Ana" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <local:StoryAvatar Initials="BL" Ring="New" FaceColor="#14A394" />
                        <Label Style="{StaticResource StoryName}" Text="Bruno" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <local:StoryAvatar Initials="CM" Ring="New" FaceColor="#9D0208" />
                        <Label Style="{StaticResource StoryName}" Text="Carla" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <local:StoryAvatar Initials="DR" Ring="Seen" FaceColor="#8B93A1" />
                        <Label Style="{StaticResource StoryName}" Text="Diego" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <local:StoryAvatar Initials="EF" Ring="Seen" FaceColor="#F48C06" />
                        <Label Style="{StaticResource StoryName}" Text="Elisa" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Status na borda: verde online, vermelho com traço ocupado, âmbar com lua ausente. -->
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource FieldLabel}" Text="Status da equipe" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,12">
                            <local:StoryAvatar Initials="AS" Size="44" Status="Online" FaceColor="#E85D04" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Ana Souza" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource Caption}" Text="Online" TextColor="{DynamicResource SuccessText}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,12">
                            <local:StoryAvatar Initials="BL" Size="44" Status="Busy" FaceColor="#14A394" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Bruno Lima" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource Caption}" Text="Em reunião até 15h" TextColor="{DynamicResource DangerText}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,12">
                            <local:StoryAvatar Initials="CM" Size="44" Status="Away" FaceColor="#9D0208" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Carla Mendes" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource Caption}" Text="Ausente há 20 min" TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
        <!-- /snippet:avatar.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="StoryAvatar: anel desenhado como um anel par-ímpar com o degradê da paleta, e status com forma própria (traço no ocupado, lua no ausente), para não depender só da cor." />

    </VerticalStackLayout>

</ContentView>
