<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Icons.IconsBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="FontImageSource com glifo Unicode" />
            <!-- snippet:icons.base -->
            <HorizontalStackLayout Spacing="16">
                <Image WidthRequest="24" HeightRequest="24">
                    <Image.Source>
                        <FontImageSource Glyph="★" Color="Gray" Size="24" FontFamily="{OnPlatform WinUI='Segoe UI Symbol'}" />
                    </Image.Source>
                </Image>
                <Image WidthRequest="24" HeightRequest="24">
                    <Image.Source>
                        <FontImageSource Glyph="⚙" Color="Gray" Size="24" FontFamily="{OnPlatform WinUI='Segoe UI Symbol'}" />
                    </Image.Source>
                </Image>
                <Label Text="✉" FontSize="24" />
            </HorizontalStackLayout>
            <!-- /snippet:icons.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="Sem uma fonte de ícones, sobram os glifos Unicode: no Windows o FontImageSource nem desenha sem uma fonte que tenha o glifo (aqui, Segoe UI Symbol), o desenho muda de plataforma para plataforma, alguns viram emoji colorido e o conjunto é pequeno." />

    </VerticalStackLayout>

</ContentView>
