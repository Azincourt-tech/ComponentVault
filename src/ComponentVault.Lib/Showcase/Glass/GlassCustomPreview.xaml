<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             xmlns:fluent="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             x:Class="ComponentVault.Lib.Showcase.Glass.GlassCustomPreview">

    <!-- snippet:glass.custom -->
    <ContentView.Resources>
        <!-- Vidro = branco translúcido + aresta com brilho em cima + sombra difusa embaixo -->
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#99FFFFFF" Offset="0" />
            <GradientStop Color="#1FFFFFFF" Offset="0.4" />
            <GradientStop Color="#0AFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#2EFFFFFF" />
            <Setter Property="Stroke" Value="{StaticResource GlassEdge}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="Shadow">
                <Shadow Brush="Black" Opacity="0.22" Radius="28" Offset="0,12" />
            </Setter>
        </Style>
        <Style x:Key="OnGlass" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        </Style>
    </ContentView.Resources>

    <Grid HeightRequest="460">
        <!-- Cena: o vidro só se lê como vidro sobre algo vivo atrás dele -->
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1B3F" Offset="0" />
                    <GradientStop Color="#123C6B" Offset="0.5" />
                    <GradientStop Color="#3A1430" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse WidthRequest="320" HeightRequest="320" HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-80,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#CC2F6FE4" Offset="0" />
                            <GradientStop Color="#002F6FE4" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse WidthRequest="300" HeightRequest="300" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-40,-60">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#B3F0527E" Offset="0" />
                            <GradientStop Color="#00F0527E" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse WidthRequest="220" HeightRequest="220" HorizontalOptions="Center" VerticalOptions="Center" Margin="80,0,0,40">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#9914B8A6" Offset="0" />
                            <GradientStop Color="#0014B8A6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Border>

        <!-- Painéis de vidro -->
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340">

            <!-- Tocando agora -->
            <Border Style="{StaticResource GlassPanel}" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8A65" Offset="0" />
                                <GradientStop Color="#F0527E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <mi:MauiIcon Icon="{x:Static fluent:FluentIcons.Play24}" IconSize="22" IconColor="White" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource OnGlass}" Text="Tocando agora" FontSize="13" Opacity="0.75" />
                        <Label Style="{StaticResource OnGlass}" Text="Luz difusa" FontFamily="{StaticResource FontSemiBold}" FontSize="17" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                            BackgroundColor="#33FFFFFF" VerticalOptions="Center"
                            SemanticProperties.Description="Pausar">
                        <mi:MauiIcon Icon="{x:Static fluent:FluentIcons.Pause24}" IconSize="18" IconColor="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Indicador -->
            <Border Style="{StaticResource GlassPanel}" Padding="20,18">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource OnGlass}" Text="Componentes no vault" FontSize="13" Opacity="0.75" />
                    <HorizontalStackLayout Spacing="10">
                        <Label Style="{StaticResource OnGlass}" Text="30" FontFamily="{StaticResource FontBold}" FontSize="40" CharacterSpacing="-1" />
                        <Label Style="{StaticResource OnGlass}" Text="+12 este mês" FontSize="14" TextColor="#7BE8B8" VerticalOptions="End" Margin="0,0,0,8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Barra flutuante em cápsula -->
            <Border Style="{StaticResource GlassPanel}" StrokeShape="RoundRectangle 30" Padding="8" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="White"
                            SemanticProperties.Description="Início">
                        <mi:MauiIcon Icon="{x:Static fluent:FluentIcons.Home24}" IconSize="20" IconColor="#0A0E1C" />
                    </Border>
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="Transparent"
                            SemanticProperties.Description="Buscar">
                        <mi:MauiIcon Icon="{x:Static fluent:FluentIcons.Search24}" IconSize="20" IconColor="White" />
                    </Border>
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="Transparent"
                            SemanticProperties.Description="Favoritos">
                        <mi:MauiIcon Icon="{x:Static fluent:FluentIcons.Heart24}" IconSize="20" IconColor="White" />
                    </Border>
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="Transparent"
                            SemanticProperties.Description="Ajustes">
                        <mi:MauiIcon Icon="{x:Static fluent:FluentIcons.Settings24}" IconSize="20" IconColor="White" />
                    </Border>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
    <!-- /snippet:glass.custom -->

</ContentView>
