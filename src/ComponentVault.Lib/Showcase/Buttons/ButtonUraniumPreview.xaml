<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="clr-namespace:UraniumUI.Material.Resources;assembly=UraniumUI.Material"
             x:Class="ComponentVault.Lib.Showcase.Buttons.ButtonUraniumPreview">

    <!--
      Os estilos Material do UraniumUI ficam restritos a esta View (merge local),
      para não vazarem para as variantes Base e Estilizado do resto do app.
    -->
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <material:StyleResource />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Material Design 3: as cinco ênfases" />
            <!-- snippet:button.uranium -->
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="Filled" StyleClass="FilledButton" Margin="0,0,10,10" />
                <Button Text="Tonal" StyleClass="FilledTonalButton" Margin="0,0,10,10" />
                <Button Text="Elevated" StyleClass="ElevatedButton" Margin="0,0,10,10" />
                <Button Text="Outlined" StyleClass="OutlinedButton" Margin="0,0,10,10" />
                <Button Text="Text" StyleClass="TextButton" Margin="0,0,10,10" />
            </FlexLayout>
            <!-- /snippet:button.uranium -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodyMuted}"
               Text="Depois de UseUraniumUI() e UseUraniumUIMaterial() no MauiProgram, basta o StyleClass. A paleta é a do Material 3 padrão; para casar com a marca, passe ColorsOverride ao StyleResource." />

    </VerticalStackLayout>

</ContentView>
