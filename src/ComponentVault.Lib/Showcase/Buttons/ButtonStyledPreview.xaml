<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             x:Class="ComponentVault.Lib.Showcase.Buttons.ButtonStyledPreview">

    <!-- snippet:button.styled -->
    <VerticalStackLayout Spacing="28">

        <!-- Um primário por tela; o resto desce na hierarquia. -->
        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Hierarquia" />
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="Publicar" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
                <Button Text="Salvar rascunho" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                <Button Text="Cancelar" Style="{StaticResource TertiaryButton}" Margin="0,0,10,10" />
                <Button Text="Excluir" Style="{StaticResource DangerButton}" Margin="0,0,10,10" />
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Com ícone" />
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="Novo componente"
                        Style="{StaticResource AccentButton}"
                        ImageSource="{mi:Fluent Icon=Add20, IconSize=18, IconColor={StaticResource OnAccent}}"
                        ContentLayout="Left,8"
                        Margin="0,0,10,10" />
                <Button Text="Compartilhar"
                        Style="{StaticResource SecondaryButton}"
                        ImageSource="{mi:Fluent Icon=Share20, IconSize=18, IconColor={DynamicResource Ink}}"
                        ContentLayout="Left,8"
                        Margin="0,0,10,10" />
                <!-- Só ícone: 44×44 e descrição para leitor de tela. -->
                <Button Style="{StaticResource SecondaryButton}"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        ImageSource="{mi:Fluent Icon=Copy20, IconSize=18, IconColor={DynamicResource Ink}}"
                        SemanticProperties.Description="Copiar"
                        ToolTipProperties.Text="Copiar"
                        Margin="0,0,10,10" />
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Tamanhos" />
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="Grande" Style="{StaticResource PrimaryButtonLarge}" Margin="0,0,10,10" />
                <Button Text="Padrão" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
                <Button Text="Pequeno" Style="{StaticResource PrimaryButtonSmall}" Margin="0,0,10,10" />
            </FlexLayout>
        </VerticalStackLayout>

        <!-- Carregando: o rótulo diz o que está acontecendo e um segundo toque é ignorado. -->
        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Carregando e desabilitado" />
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Grid Margin="0,0,10,10">
                    <Button x:Name="SaveButton"
                            Text="Salvar alterações"
                            Style="{StaticResource PrimaryButton}"
                            Padding="32,11"
                            Clicked="OnSaveClicked" />
                    <ActivityIndicator x:Name="SaveSpinner"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{DynamicResource OnInk}"
                                       WidthRequest="16" HeightRequest="16"
                                       HorizontalOptions="Start" VerticalOptions="Center"
                                       Margin="18,0,0,0"
                                       InputTransparent="True" />
                </Grid>
                <Button Text="Indisponível" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,10,10" />
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Largura total (ação principal no celular)" />
            <Button Text="Continuar" Style="{StaticResource PrimaryButtonLarge}" HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </VerticalStackLayout>
    <!-- /snippet:button.styled -->

</ContentView>
