<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Buttons.ButtonBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:button.base -->
            <HorizontalStackLayout Spacing="12">
                <Button Text="Clique aqui" Clicked="OnClicked" />
                <Button Text="Desabilitado" IsEnabled="False" />
            </HorizontalStackLayout>
            <!-- /snippet:button.base -->
            <Label x:Name="CounterLabel" Style="{StaticResource Caption}" Text="Nenhum clique ainda" />
        </VerticalStackLayout>

        <Label Style="{StaticResource BodyMuted}"
               Text="Sem estilo, o Button segue o visual nativo: WinUI no Windows, Material no Android. Altura, raio e cores mudam de plataforma para plataforma, e não há estado de carregamento." />

    </VerticalStackLayout>

</ContentView>
