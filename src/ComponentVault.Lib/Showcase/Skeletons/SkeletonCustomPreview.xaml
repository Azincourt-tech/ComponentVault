<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ComponentVault.Lib.Showcase.Skeletons.SkeletonCustomPreview">

    <ContentView.Resources>
        <Style x:Key="Bone" TargetType="BoxView">
            <Setter Property="Color" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HeightRequest" Value="12" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="20">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label x:Name="StatusLabel" Style="{StaticResource BodySmall}" Text="Carregando com placeholders que imitam o layout final."
                   VerticalOptions="Center" />
            <Button x:Name="ToggleButton" Grid.Column="1" Text="Mostrar conteúdo"
                    Style="{StaticResource SecondaryButtonSmall}" Clicked="OnToggleClicked" />
        </Grid>

        <Grid>
            <!-- snippet:skeleton.custom -->
            <!-- Placeholders com a MESMA geometria do conteúdo: nada pula quando os dados chegam. -->
            <VerticalStackLayout x:Name="Skeleton" Spacing="16"
                                 SemanticProperties.Description="Carregando conteúdo">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                            <BoxView Style="{StaticResource Bone}" WidthRequest="44" HeightRequest="44" CornerRadius="22" />
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <BoxView Style="{StaticResource Bone}" WidthRequest="160" />
                                <BoxView Style="{StaticResource Bone}" WidthRequest="230" HeightRequest="10" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                            <BoxView Style="{StaticResource Bone}" WidthRequest="44" HeightRequest="44" CornerRadius="22" />
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <BoxView Style="{StaticResource Bone}" WidthRequest="120" />
                                <BoxView Style="{StaticResource Bone}" WidthRequest="200" HeightRequest="10" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <BoxView Style="{StaticResource Bone}" HeightRequest="120" HorizontalOptions="Fill" CornerRadius="10" />
                        <BoxView Style="{StaticResource Bone}" WidthRequest="180" HeightRequest="14" />
                        <BoxView Style="{StaticResource Bone}" HorizontalOptions="Fill" HeightRequest="10" />
                        <BoxView Style="{StaticResource Bone}" WidthRequest="140" HeightRequest="10" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- /snippet:skeleton.custom -->

            <!-- Conteúdo real, no mesmo lugar e com as mesmas medidas. -->
            <VerticalStackLayout x:Name="LoadedContent" Spacing="16" IsVisible="False" Opacity="0">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{DynamicResource SurfaceAlt}">
                                <Label Text="AR" Style="{StaticResource BodySmall}" FontFamily="{StaticResource FontSemiBold}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Style="{StaticResource Body}" FontFamily="{StaticResource FontMedium}" Text="Ana Ribeiro" />
                                <Label Style="{StaticResource BodySmall}" Text="Publicou 3 componentes novos" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{DynamicResource SurfaceAlt}">
                                <Label Text="DM" Style="{StaticResource BodySmall}" FontFamily="{StaticResource FontSemiBold}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Style="{StaticResource Body}" FontFamily="{StaticResource FontMedium}" Text="Diego Moura" />
                                <Label Style="{StaticResource BodySmall}" Text="Comentou no Slider" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Border HeightRequest="120" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource InfoTint}">
                            <Label Text="Prévia do relatório" Style="{StaticResource BodySmall}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource CardTitle}" Text="Uso de componentes em novembro" />
                        <Label Style="{StaticResource BodySmall}" Text="O Button continua no topo; o Slider custom subiu duas posições." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

    </VerticalStackLayout>

</ContentView>
