<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Badges.BadgeBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Border + Label" />
            <!-- snippet:badge.base -->
            <HorizontalStackLayout Spacing="8">
                <Border Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                        BackgroundColor="LightSkyBlue">
                    <Label Text="Novo" FontSize="12" TextColor="Black" />
                </Border>
                <Border Padding="10,4" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 999">
                    <Label Text="Beta" FontSize="12" />
                </Border>
            </HorizontalStackLayout>
            <!-- /snippet:badge.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="Não existe badge no MAUI. Montar à mão funciona, mas cada tela repete cores, raio e padding, e o tema escuro fica por conta de quem usa: o azul-claro fixo acima ofusca no escuro." />

    </VerticalStackLayout>

</ContentView>
