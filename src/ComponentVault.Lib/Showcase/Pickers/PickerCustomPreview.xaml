<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.Pickers"
             xmlns:fit="clr-namespace:ComponentVault.Lib.Theming"
             x:Class="ComponentVault.Lib.Showcase.Pickers.PickerCustomPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:picker.custom -->
        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource FieldLabel}" Text="Lembrete diário" VerticalOptions="Center" />
                <Label x:Name="SummaryLabel" Grid.Column="1" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <!-- Duas rodas lado a lado (hora e minuto). Arraste para girar ou toque numa vizinha. -->
            <Border Style="{StaticResource Card}" Padding="16,8" fit:Fit.MaxWidth="360">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                    <local:WheelPicker x:Name="HourWheel" SelectedIndex="8" SelectionChanged="OnTimeChanged"
                                       SemanticProperties.Hint="Hora" />
                    <Label Grid.Column="1" Text=":" FontFamily="JakartaSemiBold" FontSize="20"
                           TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
                    <local:WheelPicker x:Name="MinuteWheel" Grid.Column="2" SelectedIndex="6" SelectionChanged="OnTimeChanged"
                                       SemanticProperties.Hint="Minuto" />
                </Grid>
            </Border>

        </VerticalStackLayout>
        <!-- /snippet:picker.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="WheelPicker: cada opção é um Label posicionado pela distância ao centro, com escala, opacidade e RotationX formando o cilindro. Arrastar gira; soltar encaixa na opção mais próxima com uma animação curta." />

    </VerticalStackLayout>

</ContentView>
