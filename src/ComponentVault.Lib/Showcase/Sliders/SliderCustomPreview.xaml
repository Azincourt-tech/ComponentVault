<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fit="clr-namespace:ComponentVault.Lib.Theming"
             xmlns:sliders="clr-namespace:ComponentVault.Lib.Showcase.Sliders"
             x:Class="ComponentVault.Lib.Showcase.Sliders.SliderCustomPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:slider.custom -->
        <VerticalStackLayout Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource FieldLabel}" Text="Faixa de preço" VerticalOptions="Center" />
                <Label x:Name="RangeLabel" Grid.Column="1" Style="{StaticResource Body}"
                       FontFamily="{StaticResource FontSemiBold}" />
            </Grid>
            <sliders:RangeSlider x:Name="PriceRange"
                                 Minimum="0" Maximum="1000" Step="10"
                                 LowerValue="120" UpperValue="680"
                                 ValuesChanged="OnRangeChanged" />
            <Grid ColumnDefinitions="*,*">
                <Label Style="{StaticResource Caption}" Text="R$ 0" />
                <Label Grid.Column="1" Style="{StaticResource Caption}" Text="R$ 1.000" HorizontalOptions="End" />
            </Grid>
        </VerticalStackLayout>
        <!-- /snippet:slider.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="O MAUI não tem slider de faixa. Este é desenhado num GraphicsView: o polegar mais perto do toque é o que se move, os valores encaixam de 10 em 10 e nunca se cruzam." />

    </VerticalStackLayout>

</ContentView>
