<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Sliders.SliderBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:slider.base -->
            <VerticalStackLayout Spacing="8">
                <Slider x:Name="DemoSlider" Minimum="0" Maximum="100" Value="40" />
                <Label x:DataType="Slider"
                       Text="{Binding Value, Source={x:Reference DemoSlider}, StringFormat='Value = {0:F2}'}" />
                <Slider Value="0.7" IsEnabled="False" />
            </VerticalStackLayout>
            <!-- /snippet:slider.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="O valor é contínuo (40,37...) e não há rótulo, mínimo, máximo nem passo: tudo isso fica por conta de quem usa." />

    </VerticalStackLayout>

</ContentView>
