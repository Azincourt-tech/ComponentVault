<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fit="clr-namespace:ComponentVault.Lib.Theming"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="ComponentVault.Lib.Showcase.Sliders.SliderStyledPreview">

    <ContentView.Resources>
        <!-- Valor em pílula: tom de destaque leve, número em mono para não "dançar" ao arrastar. -->
        <Style x:Key="ValuePill" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BackgroundColor" Value="{DynamicResource AccentTint}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ValuePillText" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
        </Style>
    </ContentView.Resources>

    <!-- snippet:slider.styled -->
    <VerticalStackLayout Spacing="28">

        <!--
          Volume: os ícones nas pontas dizem o que é "menos" e "mais" sem ler números; tocar no
          alto-falante da esquerda silencia e devolve o volume anterior. Encaixa de 5 em 5.
        -->
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource FieldLabel}" Text="Volume" VerticalOptions="Center" />
                <Border Grid.Column="1" Style="{StaticResource ValuePill}">
                    <Label x:Name="VolumeValue" Style="{StaticResource ValuePillText}" Text="65%" />
                </Border>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Grid WidthRequest="32" HeightRequest="32" VerticalOptions="Center" SemanticProperties.Description="Silenciar">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnMuteTapped" /></Grid.GestureRecognizers>
                    <mic:MauiIcon x:Name="MuteIcon" Icon="{mi:Fluent Icon=Speaker020}" IconSize="18"
                                  IconColor="{DynamicResource InkSecondary}"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VaultSlider}"
                        Minimum="0" Maximum="100" Value="65"
                        ValueChanged="OnVolumeChanged"
                        SemanticProperties.Description="Volume" />
                <mic:MauiIcon Grid.Column="2" Icon="{mi:Fluent Icon=Speaker220}" IconSize="18"
                              IconColor="{DynamicResource InkSecondary}" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- Tamanho do texto: "A" pequeno e grande nas pontas, e o efeito aparece na hora no exemplo. -->
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource FieldLabel}" Text="Tamanho do texto" VerticalOptions="Center" />
                <Border Grid.Column="1" Style="{StaticResource ValuePill}">
                    <Label Style="{StaticResource ValuePillText}" x:DataType="Slider"
                           Text="{Binding Value, Source={x:Reference FontSlider}, StringFormat='{0:F0} px'}" />
                </Border>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="A" FontFamily="{StaticResource FontSemiBold}" FontSize="13" TextColor="{DynamicResource InkSecondary}"
                       WidthRequest="32" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Slider x:Name="FontSlider" Grid.Column="1" Style="{StaticResource VaultSlider}"
                        Minimum="13" Maximum="24" Value="16"
                        ValueChanged="OnFontChanged"
                        SemanticProperties.Description="Tamanho do texto" />
                <Label Grid.Column="2" Text="A" FontFamily="{StaticResource FontSemiBold}" FontSize="22" TextColor="{DynamicResource InkSecondary}"
                       VerticalOptions="Center" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,6,0,0">
                <Label Style="{StaticResource Body}" x:DataType="Slider"
                       FontSize="{Binding Value, Source={x:Reference FontSlider}}"
                       Text="Componentes que você copia e cola em menos de cinco minutos." />
            </Border>
        </VerticalStackLayout>

    </VerticalStackLayout>
    <!-- /snippet:slider.styled -->

</ContentView>
