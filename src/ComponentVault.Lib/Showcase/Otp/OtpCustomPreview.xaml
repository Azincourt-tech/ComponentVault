<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.Otp"
             x:Class="ComponentVault.Lib.Showcase.Otp.OtpCustomPreview">

    <!-- snippet:otp.custom -->
    <VerticalStackLayout Spacing="16">

        <VerticalStackLayout Spacing="4">
            <Label Style="{StaticResource CardTitle}" Text="Digite o código de verificação" />
            <Label Style="{StaticResource BodySmall}" Text="Enviamos 6 dígitos para w•••@gmail.com. Para testar, use 123456." />
        </VerticalStackLayout>

        <local:OtpInput x:Name="CodeInput" Length="6" Completed="OnCompleted" />

        <Label x:Name="StatusLabel" Style="{StaticResource BodySmall}" IsVisible="False" />

        <HorizontalStackLayout Spacing="4">
            <Label Style="{StaticResource BodySmall}" Text="Não recebeu?" VerticalOptions="Center" />
            <Button x:Name="ResendButton" Text="Reenviar código" Style="{StaticResource TertiaryButton}"
                    Padding="8,6" MinimumHeightRequest="36" Clicked="OnResend" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
    <!-- /snippet:otp.custom -->

</ContentView>
