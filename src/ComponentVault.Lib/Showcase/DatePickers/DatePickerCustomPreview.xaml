<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.DatePickers"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="ComponentVault.Lib.Showcase.DatePickers.DatePickerCustomPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:datepicker.custom -->
        <VerticalStackLayout Spacing="12">

            <Label Style="{StaticResource FieldLabel}" Text="Período da reserva" />

            <!-- Pressione um dia e arraste até outro, ou toque na ida e depois na volta. -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <local:DateRangeStrip x:Name="Strip" RangeChanged="OnRangeChanged" />
            </Border>

            <!-- Resumo em frase: confirma a escolha sem precisar reler a grade. -->
            <HorizontalStackLayout Spacing="8">
                <mic:MauiIcon Icon="{mi:Fluent Icon=CalendarLtr20}" IconSize="18" IconColor="{DynamicResource InkSecondary}" VerticalOptions="Center" />
                <Label x:Name="SummaryLabel" Style="{StaticResource Body}" LineHeight="1" VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
        <!-- /snippet:datepicker.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="DateRangeStrip: três semanas em vez do mês inteiro, porque a maioria das reservas começa logo. A faixa é desenhada com Microsoft.Maui.Graphics e estica até o dia sob o dedo; os dias passados ficam bloqueados." />

    </VerticalStackLayout>

</ContentView>
