<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.DatePickers.DatePickerBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:datepicker.base -->
            <VerticalStackLayout Spacing="12">
                <DatePicker Format="dd/MM/yyyy" />
                <TimePicker Format="HH:mm" />
            </VerticalStackLayout>
            <!-- /snippet:datepicker.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="DatePicker e TimePicker abrem o seletor nativo de cada plataforma. Sem rótulo e sem ícone, não dá para saber o que a data significa." />

    </VerticalStackLayout>

</ContentView>
