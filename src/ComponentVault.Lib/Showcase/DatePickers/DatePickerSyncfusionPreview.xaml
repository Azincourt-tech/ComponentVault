<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cal="clr-namespace:Syncfusion.Maui.Toolkit.Calendar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="ComponentVault.Lib.Showcase.DatePickers.DatePickerSyncfusionPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:datepicker.syncfusion -->
        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource FieldLabel}" Text="Período da viagem" VerticalOptions="Center" />
                <Label x:Name="RangeLabel" Grid.Column="1" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <!--
              Calendário sempre visível com seleção de intervalo: o primeiro toque marca a ida, o segundo
              a volta, e os dias entre eles ficam no tom leve. Datas passadas ficam bloqueadas.
            -->
            <Border Style="{StaticResource Card}" Padding="8">
                <cal:SfCalendar x:Name="TripCalendar"
                                View="Month"
                                SelectionMode="Range"
                                SelectionShape="Circle"
                                EnablePastDates="False"
                                ShowTrailingAndLeadingDates="False"
                                HeightRequest="320"
                                Background="Transparent"
                                StartRangeSelectionBackground="{StaticResource Accent}"
                                EndRangeSelectionBackground="{StaticResource Accent}"
                                TodayHighlightBrush="{StaticResource Accent}"
                                SelectionChanged="OnSelectionChanged">
                    <!-- Dias da semana com três letras (dom, seg, ter); ida e volta em branco sobre o destaque. -->
                    <cal:SfCalendar.MonthView>
                        <cal:CalendarMonthView>
                            <cal:CalendarMonthView.HeaderView>
                                <cal:CalendarMonthHeaderView TextFormat="ddd" Height="36" />
                            </cal:CalendarMonthView.HeaderView>
                            <cal:CalendarMonthView.SelectionTextStyle>
                                <cal:CalendarTextStyle TextColor="{StaticResource OnAccent}" FontFamily="JakartaSemiBold" FontSize="14" />
                            </cal:CalendarMonthView.SelectionTextStyle>
                        </cal:CalendarMonthView>
                    </cal:SfCalendar.MonthView>
                </cal:SfCalendar>
            </Border>

        </VerticalStackLayout>
        <!-- /snippet:datepicker.syncfusion -->

        <Label Style="{StaticResource BodySmall}"
               Text="O SfCalendar (Syncfusion Toolkit, MIT) seleciona um dia, vários ou intervalos, navega por mês, ano, década e século, bloqueia datas e também abre como popup. O DatePicker do MAUI só escolhe uma data." />

    </VerticalStackLayout>

</ContentView>
