<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
             x:Class="ComponentVault.Lib.Showcase.DatePickers.DatePickerUraniumPreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="DatePickerField e TimePickerField" />
            <!--
              Largura do conteúdo: uma data e um horário são curtos, campo largo sobra vazio.
              280 é o mínimo que cabe o seletor de horário nativo do Windows mais o botão de limpar.
            -->
            <!-- snippet:datepicker.uranium -->
            <VerticalStackLayout Spacing="16" WidthRequest="{OnIdiom Phone=-1, Default=280}" HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                <material:DatePickerField Title="Data de entrega" Format="dd/MM/yyyy" AllowClear="True" />
                <material:TimePickerField Title="Horário" Format="HH:mm" AllowClear="True" Time="14:30" />
            </VerticalStackLayout>
            <!-- /snippet:datepicker.uranium -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="Campos Material com título flutuante e limpar: a data vazia mostra o título no lugar do valor, e o horário preenchido o leva para a borda. Úteis quando a data é opcional, porque vazio é um estado válido, diferente do DatePicker nativo, que sempre tem um valor." />

    </VerticalStackLayout>

</ContentView>
