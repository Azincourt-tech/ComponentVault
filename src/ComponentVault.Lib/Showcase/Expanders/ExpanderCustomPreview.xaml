<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComponentVault.Lib.Showcase.Expanders"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="ComponentVault.Lib.Showcase.Expanders.ExpanderCustomPreview">

    <ContentView.Resources>
        <Style x:Key="Feature" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="Auto,*" />
            <Setter Property="ColumnSpacing" Value="10" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="24">

        <!-- snippet:expander.custom -->
        <VerticalStackLayout Spacing="12">

            <Label Style="{StaticResource FieldLabel}" Text="Escolha um plano" />

            <!-- Uma aberta por vez: abrir um plano fecha o outro. O preço fica à vista mesmo fechado. -->
            <local:AccordionStack>

                <local:Collapsible Title="Gratuito" Summary="R$ 0">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Catálogo completo" />
                        </Grid>
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Copiar o código dos exemplos" />
                        </Grid>
                    </VerticalStackLayout>
                </local:Collapsible>

                <local:Collapsible Title="Pro" Summary="R$ 29/mês" IsExpanded="True">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Tudo do Gratuito" />
                        </Grid>
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Exportar snippets e favoritos" />
                        </Grid>
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Temas personalizados" />
                        </Grid>
                        <Button Text="Assinar o Pro" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </local:Collapsible>

                <local:Collapsible Title="Equipe" Summary="R$ 99/mês">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Tudo do Pro para até 10 pessoas" />
                        </Grid>
                        <Grid Style="{StaticResource Feature}">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Checkmark20}" IconSize="16" IconColor="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource Body}" LineHeight="1" Text="Biblioteca compartilhada" />
                        </Grid>
                    </VerticalStackLayout>
                </local:Collapsible>

            </local:AccordionStack>

        </VerticalStackLayout>
        <!-- /snippet:expander.custom -->

        <Label Style="{StaticResource BodySmall}"
               Text="Collapsible: o conteúdo é medido e o recorte cresce até ele em 260ms, então a tela desliza em vez de pular. O + desenhado vira − e a seção aberta ganha a borda de destaque. O AccordionStack fecha a anterior ao abrir outra." />

    </VerticalStackLayout>

</ContentView>
