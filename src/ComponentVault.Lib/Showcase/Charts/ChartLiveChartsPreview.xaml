<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="ComponentVault.Lib.Showcase.Charts.ChartLiveChartsPreview">

    <!-- snippet:chart.livecharts -->
    <!--
      Um painel só (sem card dentro de card): número principal com a variação, barras com o mês
      atual em destaque e a meta tracejada; embaixo, a rosca com o total no meio e a legenda em
      XAML, na fonte do app. Os gráficos têm fundo transparente para assentar em qualquer tema.
    -->
    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="2">
                    <Label Style="{StaticResource CardTitle}" Text="Pedidos por mês" />
                    <Label Style="{StaticResource Caption}" Text="Últimos 6 meses · linha tracejada é a meta" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                    <Label Style="{StaticResource SectionHeader}" FontSize="24" Text="1.176" HorizontalOptions="End" />
                    <Label Style="{StaticResource Caption}" TextColor="{DynamicResource SuccessText}"
                           Text="+40% de jun a nov" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Grid>
            <lvc:CartesianChart x:Name="OrdersChart" HeightRequest="220" BackgroundColor="Transparent" />
        </VerticalStackLayout>

        <BoxView Style="{StaticResource Divider}" />

        <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='200,*'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
              ColumnSpacing="32" RowSpacing="16">
            <Grid WidthRequest="200" HeightRequest="200" HorizontalOptions="Center">
                <lvc:PieChart x:Name="ChannelChart" BackgroundColor="Transparent" />
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                    <Label Style="{StaticResource SectionHeader}" FontSize="22" Text="1.176" HorizontalOptions="Center" />
                    <Label Style="{StaticResource Caption}" Text="pedidos" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.Row="{OnIdiom Phone=1, Default=0}"
                                 Spacing="14" VerticalOptions="Center"
                                 MaximumWidthRequest="300" HorizontalOptions="Start">
                <Label Style="{StaticResource CardTitle}" Text="Pedidos por canal" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Accent}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource Body}" Text="App" />
                    <Label Grid.Column="2" Style="{StaticResource BodyMuted}" Text="58%" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Accent}" Opacity="0.55" VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource Body}" Text="Site" />
                    <Label Grid.Column="2" Style="{StaticResource BodyMuted}" Text="31%" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Accent}" Opacity="0.25" VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource Body}" Text="Loja física" />
                    <Label Grid.Column="2" Style="{StaticResource BodyMuted}" Text="11%" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

    </VerticalStackLayout>
    <!-- /snippet:chart.livecharts -->

</ContentView>
