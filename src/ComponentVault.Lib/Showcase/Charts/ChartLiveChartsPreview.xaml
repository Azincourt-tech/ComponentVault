<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="ComponentVault.Lib.Showcase.Charts.ChartLiveChartsPreview">

    <!-- snippet:chart.livecharts -->
    <VerticalStackLayout Spacing="16">

        <Border Style="{StaticResource Card}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource CardTitle}" Text="Pedidos por mês" />
                        <Label Style="{StaticResource Caption}" Text="Barras: 2026 · Linha: meta" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Style="{StaticResource SectionHeader}" Text="1.284" VerticalOptions="Center" />
                </Grid>
                <lvc:CartesianChart x:Name="OrdersChart" HeightRequest="240" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource CardTitle}" Text="Pedidos por canal" />
                <lvc:PieChart x:Name="ChannelChart" HeightRequest="220" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
    <!-- /snippet:chart.livecharts -->

</ContentView>
