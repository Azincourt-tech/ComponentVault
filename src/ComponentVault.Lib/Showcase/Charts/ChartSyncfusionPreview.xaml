<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:fit="clr-namespace:ComponentVault.Lib.Theming"
             x:Class="ComponentVault.Lib.Showcase.Charts.ChartSyncfusionPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:chart.syncfusion -->
        <Grid ColumnDefinitions="{fit:OnWidth Compact='*', Default='3*,2*'}"
              RowDefinitions="{fit:OnWidth Compact='Auto,Auto', Default='Auto'}"
              ColumnSpacing="16" RowSpacing="16">

            <!-- Colunas: só a do mês atual na cor de destaque; grade horizontal fina, sem eixo vertical. -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="Downloads por mês" />
                    <Label Style="{StaticResource CardTitle}" Text="12,8 mil em novembro" />
                    <chart:SfCartesianChart x:Name="Downloads" HeightRequest="200">
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis ShowMajorGridLines="False">
                                <chart:CategoryAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle FontFamily="JakartaRegular" FontSize="12" TextColor="{DynamicResource InkTertiary}" />
                                </chart:CategoryAxis.LabelStyle>
                                <chart:CategoryAxis.AxisLineStyle>
                                    <chart:ChartLineStyle Stroke="{DynamicResource Hairline}" />
                                </chart:CategoryAxis.AxisLineStyle>
                                <chart:CategoryAxis.MajorTickStyle>
                                    <chart:ChartAxisTickStyle StrokeWidth="0" />
                                </chart:CategoryAxis.MajorTickStyle>
                            </chart:CategoryAxis>
                        </chart:SfCartesianChart.XAxes>
                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis Minimum="0" Interval="5">
                                <chart:NumericalAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle FontFamily="JakartaRegular" FontSize="12" TextColor="{DynamicResource InkTertiary}" LabelFormat="0'k'" />
                                </chart:NumericalAxis.LabelStyle>
                                <chart:NumericalAxis.AxisLineStyle>
                                    <chart:ChartLineStyle StrokeWidth="0" />
                                </chart:NumericalAxis.AxisLineStyle>
                                <chart:NumericalAxis.MajorTickStyle>
                                    <chart:ChartAxisTickStyle StrokeWidth="0" />
                                </chart:NumericalAxis.MajorTickStyle>
                                <chart:NumericalAxis.MajorGridLineStyle>
                                    <chart:ChartLineStyle Stroke="{DynamicResource Hairline}" StrokeWidth="1" />
                                </chart:NumericalAxis.MajorGridLineStyle>
                            </chart:NumericalAxis>
                        </chart:SfCartesianChart.YAxes>
                        <chart:ColumnSeries x:Name="DownloadSeries" XBindingPath="Label" YBindingPath="Value"
                                            PointColorPath="Color" CornerRadius="6,6,0,0" Width="0.6"
                                            EnableTooltip="True" EnableAnimation="True" />
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Border>

            <!-- Rosca: o total no meio (CenterView) e a fatia maior na cor de destaque. -->
            <Border Grid.Column="{fit:OnWidth Compact=0, Default=1}" Grid.Row="{fit:OnWidth Compact=1, Default=0}"
                    Style="{StaticResource Card}" Padding="18,16">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="Plataformas" />
                    <Label Style="{StaticResource CardTitle}" Text="Onde o app roda" />
                    <chart:SfCircularChart HeightRequest="200">
                        <chart:DoughnutSeries x:Name="PlatformSeries" XBindingPath="Label" YBindingPath="Value"
                                              PointColorPath="Color" InnerRadius="0.68" StrokeWidth="0"
                                              EnableTooltip="True" EnableAnimation="True">
                            <chart:DoughnutSeries.CenterView>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="62%" FontFamily="JakartaBold" FontSize="22" TextColor="{DynamicResource Ink}" HorizontalOptions="Center" />
                                    <Label Text="Android" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </chart:DoughnutSeries.CenterView>
                        </chart:DoughnutSeries>
                    </chart:SfCircularChart>
                </VerticalStackLayout>
            </Border>

        </Grid>
        <!-- /snippet:chart.syncfusion -->

        <Label Style="{StaticResource BodySmall}"
               Text="Os gráficos do Syncfusion Toolkit (MIT) cobrem cartesiano, circular, polar, funil, pirâmide e spark, com tooltip, animação e cor por ponto (PointColorPath). Eixos e grade aceitam os tokens do design system." />

    </VerticalStackLayout>

</ContentView>
