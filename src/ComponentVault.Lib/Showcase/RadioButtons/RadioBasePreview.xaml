<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.RadioButtons.RadioBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:radio.base -->
            <VerticalStackLayout>
                <RadioButton Content="Mensal" GroupName="billing" IsChecked="True" />
                <RadioButton Content="Anual (2 meses grátis)" GroupName="billing" />
                <RadioButton Content="Vitalício" GroupName="billing" IsEnabled="False" />
            </VerticalStackLayout>
            <!-- /snippet:radio.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodySmall}"
               Text="Cada plataforma desenha o próprio círculo. Content aceita só texto simples, a não ser que se troque o ControlTemplate." />

    </VerticalStackLayout>

</ContentView>
