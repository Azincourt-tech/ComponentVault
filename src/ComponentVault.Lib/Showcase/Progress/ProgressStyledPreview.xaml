<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ComponentVault.Lib.Showcase.Progress.ProgressStyledPreview">

    <!-- snippet:progress.styled -->
    <VerticalStackLayout Spacing="28">

        <!-- Progresso determinado: o que, quanto e quanto falta. -->
        <VerticalStackLayout Spacing="10">
            <Label Style="{StaticResource FieldLabel}" Text="Envio de arquivo" />
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource Body}" FontFamily="{StaticResource FontMedium}"
                               Text="relatorio-q4.pdf" LineBreakMode="MiddleTruncation" />
                        <Label x:Name="PercentLabel" Grid.Column="1" Style="{StaticResource Body}"
                               FontFamily="{StaticResource FontSemiBold}" Text="0%" />
                    </Grid>
                    <ProgressBar x:Name="UploadBar" Style="{StaticResource VaultProgressBar}" Progress="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="DetailLabel" Style="{StaticResource Caption}"
                               Text="0 MB de 5 MB" VerticalOptions="Center" />
                        <Button x:Name="UploadButton" Grid.Column="1" Text="Enviar"
                                Style="{StaticResource SecondaryButtonSmall}" Clicked="OnUploadClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Progresso em etapas: o usuário sabe onde está e o que vem depois. -->
        <VerticalStackLayout Spacing="10">
            <Label Style="{StaticResource FieldLabel}" Text="Cadastro em etapas" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <BoxView HeightRequest="4" CornerRadius="2" Color="{StaticResource Accent}" />
                <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" Color="{StaticResource Accent}" />
                <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" Color="{DynamicResource HairlineStrong}" />
                <BoxView Grid.Column="3" HeightRequest="4" CornerRadius="2" Color="{DynamicResource HairlineStrong}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource Body}" FontFamily="{StaticResource FontSemiBold}" Text="Endereço" />
                <Label Grid.Column="1" Style="{StaticResource Caption}" Text="Etapa 2 de 4" VerticalOptions="Center" />
            </Grid>
            <Label Style="{StaticResource BodySmall}" Text="A seguir: forma de pagamento." />
        </VerticalStackLayout>

        <!-- Indeterminado em linha: o que está acontecendo e como sair. -->
        <VerticalStackLayout Spacing="10">
            <Label Style="{StaticResource FieldLabel}" Text="Carregamento em linha" />
            <Border Style="{StaticResource Card}" Padding="16,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <ActivityIndicator Style="{StaticResource VaultActivityIndicator}" IsRunning="True"
                                       VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource Body}" Text="Sincronizando 12 componentes"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="Cancelar" Style="{StaticResource TertiaryButton}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

    </VerticalStackLayout>
    <!-- /snippet:progress.styled -->

</ContentView>
