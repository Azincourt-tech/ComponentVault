<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComponentVault.Lib.Showcase.Progress.ProgressBasePreview">

    <VerticalStackLayout Spacing="24">

        <VerticalStackLayout Spacing="12">
            <Label Style="{StaticResource FieldLabel}" Text="Padrão da plataforma" />
            <!-- snippet:progress.base -->
            <VerticalStackLayout Spacing="16">
                <ProgressBar x:Name="Bar" Progress="0.4" />
                <ActivityIndicator IsRunning="True" HorizontalOptions="Start" />
                <Button Text="Animar até 100%" Clicked="OnAnimateClicked" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <!-- /snippet:progress.base -->
        </VerticalStackLayout>

        <Label Style="{StaticResource BodyMuted}"
               Text="Sem rótulo, sem porcentagem e sem contexto: quem olha não sabe o que está carregando nem quanto falta." />

    </VerticalStackLayout>

</ContentView>
