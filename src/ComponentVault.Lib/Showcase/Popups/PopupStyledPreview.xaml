<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="ComponentVault.Lib.Showcase.Popups.PopupStyledPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:popup.styled -->
        <!--
          Diálogo montado com Border, Label e Button na mesma célula do conteúdo: fundo que escurece,
          cartão que surge com escala de 0,96 a 1 e botões que dizem a ação ("Excluir", não "OK").
        -->
        <Border Style="{StaticResource Card}" HeightRequest="340">
            <Grid IsClippedToBounds="True">

                <!-- Conteúdo da tela por baixo. -->
                <VerticalStackLayout Padding="20" Spacing="14">
                    <Label Style="{StaticResource CardTitle}" Text="Projeto Atlas" />
                    <Label Style="{StaticResource BodyMuted}" Text="12 telas, 48 componentes e 3 pessoas com acesso." />
                    <Button Text="Excluir projeto" Style="{StaticResource DangerButton}" HorizontalOptions="Start" Clicked="OnOpenClicked" />
                    <Label x:Name="ResultLabel" Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <!-- Fundo escurecido: tocar fora cancela. -->
                <BoxView x:Name="Scrim" Color="Black" Opacity="0" IsVisible="False">
                    <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCancelClicked" /></BoxView.GestureRecognizers>
                </BoxView>

                <Border x:Name="Dialog" IsVisible="False" Opacity="0" Margin="20" Padding="22,20"
                        VerticalOptions="Center" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{DynamicResource SurfaceRaised}" Stroke="{DynamicResource Hairline}">
                    <VerticalStackLayout Spacing="14">
                        <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource DangerTint}" HorizontalOptions="Start">
                            <mic:MauiIcon Icon="{mi:Fluent Icon=Delete24}" IconSize="22" IconColor="{DynamicResource DangerText}"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource CardTitle}" Text="Excluir o projeto Atlas?" />
                        <Label Style="{StaticResource BodyMuted}" Text="As 12 telas vão para a lixeira e ficam lá por 30 dias. As 3 pessoas com acesso perdem o link." />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Text="Cancelar" Style="{StaticResource SecondaryButton}" Clicked="OnCancelClicked" />
                            <Button Grid.Column="1" Text="Excluir" Style="{StaticResource DangerButton}" Clicked="OnConfirmClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>
        <!-- /snippet:popup.styled -->

        <Label Style="{StaticResource BodySmall}"
               Text="Sem lib: o diálogo é uma camada na mesma célula do Grid, com tokens do design system. Diz o que vai acontecer e o que dá para desfazer, e o botão destrutivo fica à direita, na cor de perigo." />

    </VerticalStackLayout>

</ContentView>
