<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:alerts="clr-namespace:ComponentVault.Lib.Showcase.Alerts"
             x:Class="ComponentVault.Lib.Showcase.Alerts.AlertStyledPreview">

    <VerticalStackLayout Spacing="16">

        <!-- snippet:alert.styled -->
        <VerticalStackLayout x:Name="AlertStack" Spacing="12">
            <alerts:Callout Kind="Info"
                            Title="Nova versão do design system"
                            Message="Os tokens de cor mudaram. Revise componentes com cores fixas."
                            ActionText="Ver o que mudou" />
            <alerts:Callout Kind="Success"
                            Title="Componente publicado"
                            Message="O Slider custom já aparece no catálogo." />
            <alerts:Callout Kind="Warning"
                            Title="Licença Syncfusion não configurada"
                            Message="Defina SYNCFUSION_KEY para ver as variantes Syncfusion."
                            ActionText="Como configurar" />
            <alerts:Callout Kind="Danger"
                            Title="Falha ao sincronizar"
                            Message="Sem conexão. As alterações continuam salvas neste aparelho."
                            ActionText="Tentar de novo"
                            IsDismissible="False" />
        </VerticalStackLayout>
        <!-- /snippet:alert.styled -->

        <Button x:Name="ResetButton" Text="Mostrar avisos fechados" Style="{StaticResource SecondaryButtonSmall}"
                HorizontalOptions="Start" IsVisible="False" Clicked="OnResetClicked" />

    </VerticalStackLayout>

</ContentView>
