<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="ComponentVault.Lib.Showcase.Toasts.ToastStyledPreview">

    <VerticalStackLayout Spacing="24">

        <!-- snippet:toast.styled -->
        <!--
          Aviso montado com Border e Label, por cima do conteúdo (mesma célula do Grid): sobe 16 px
          enquanto aparece, fica 3 segundos e oferece desfazer. Tinta escura em qualquer tema, para
          se destacar do conteúdo.
        -->
        <Border Style="{StaticResource Card}" HeightRequest="260">
            <Grid IsClippedToBounds="True">

                <VerticalStackLayout Padding="20" Spacing="14">
                    <Label Style="{StaticResource CardTitle}" Text="Notificações por e-mail" />
                    <Label Style="{StaticResource BodyMuted}" Text="Resumo semanal toda segunda às 8h." />
                    <Button Text="Salvar preferências" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" Clicked="OnSaveClicked" />
                </VerticalStackLayout>

                <Border x:Name="Toast" IsVisible="False" Opacity="0" Margin="16" Padding="16,10,8,10"
                        VerticalOptions="End" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource Ink}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <mic:MauiIcon Icon="{mi:Fluent Icon=CheckmarkCircle20}" IconSize="20" IconColor="{StaticResource Success}"
                                      VerticalOptions="Center" />
                        <Label x:Name="ToastLabel" Grid.Column="1" FontFamily="{StaticResource FontRegular}" FontSize="14"
                               TextColor="{DynamicResource OnInk}" VerticalOptions="Center" Text="Preferências salvas" />
                        <Button x:Name="UndoButton" Grid.Column="2" Text="Desfazer" Clicked="OnUndoClicked" BackgroundColor="Transparent"
                                TextColor="{DynamicResource OnInk}" FontFamily="{StaticResource FontSemiBold}" FontSize="14"
                                Padding="12,6" MinimumHeightRequest="36" />
                    </Grid>
                </Border>

            </Grid>
        </Border>
        <!-- /snippet:toast.styled -->

        <Label Style="{StaticResource BodySmall}"
               Text="Sem lib: Border, ícone, texto e um botão de ação, animados com FadeTo e TranslateTo. Diz o que aconteceu em poucas palavras, some sozinho e deixa desfazer, em vez de pedir confirmação antes." />

    </VerticalStackLayout>

</ContentView>
