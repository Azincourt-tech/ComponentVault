<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       xmlns:home="clr-namespace:ComponentVault.App.Views.Home"
       xmlns:catalog="clr-namespace:ComponentVault.App.Views.Catalog"
       x:Class="ComponentVault.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{DynamicResource Ground}"
       Shell.ForegroundColor="{DynamicResource Ink}"
       Shell.TitleColor="{DynamicResource Ink}"
       Shell.TabBarBackgroundColor="{DynamicResource Ground}"
       Shell.TabBarForegroundColor="{DynamicResource Ink}"
       Shell.TabBarTitleColor="{DynamicResource Ink}"
       Shell.TabBarUnselectedColor="{DynamicResource InkTertiary}">

    <TabBar>
        <ShellContent Title="Início"
                      Icon="tab_home.png"
                      Route="home"
                      ContentTemplate="{DataTemplate home:HomePage}" />
        <ShellContent Title="Catálogo"
                      Icon="tab_catalog.png"
                      Route="catalog"
                      ContentTemplate="{DataTemplate catalog:CatalogPage}" />
    </TabBar>

</Shell>
