<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:ComponentVault.Lib.Resources.Theme;assembly=ComponentVault.Lib"
             x:Class="ComponentVault.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design system inteiro: cores, tokens e estilos nomeados. -->
                <theme:VaultTheme />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Espaço da barra de título do Windows: a página passa por baixo dela, o conteúdo desce
              (TitleBarInset) e o fundo animado sobe (TitleBarBleed). Zero nas outras plataformas;
              o TitleBarOverlay ajusta no Windows e zera em tela cheia.
            -->
            <Thickness x:Key="TitleBarInset">0</Thickness>
            <Thickness x:Key="TitleBarBleed">0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
