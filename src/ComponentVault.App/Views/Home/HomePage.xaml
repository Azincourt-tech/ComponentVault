<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:adaptive="clr-namespace:ComponentVault.Lib.Theming;assembly=ComponentVault.Lib"
             xmlns:vm="clr-namespace:ComponentVault.Core.ViewModels;assembly=ComponentVault.Core"
             xmlns:controls="clr-namespace:ComponentVault.App.Controls"
             xmlns:lib="clr-namespace:ComponentVault.Lib.Controls;assembly=ComponentVault.Lib"
             xmlns:motion="clr-namespace:ComponentVault.Lib.Theming;assembly=ComponentVault.Lib"
             x:Class="ComponentVault.App.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Style="{StaticResource VaultPage}"
             Title="">

    <ContentPage.Resources>
        <controls:TierToBadgeKindConverter x:Key="TierBadge" />
    </ContentPage.Resources>

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
        <!-- Luz ambiente: só acende no tema Vidro, e deriva devagar. -->
        <lib:AmbientBackground Grid.RowSpan="3" />

        <!-- Navegação e tema: no topo no desktop, embaixo no celular -->
        <controls:NavDock Grid.Row="{adaptive:OnWidth Compact=2, Default=0}" Section="Home" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{adaptive:OnWidth Compact='20,16', Default='40,32'}" Spacing="52"
                                 MaximumWidthRequest="{StaticResource ContentMaxWidth}">

                <!-- Abertura -->
                <Grid Margin="0,12,0,0">

                    <VerticalStackLayout Spacing="16">
                        <Label Style="{StaticResource Display}" FontSize="{adaptive:OnWidth Compact=34, Default=48}"
                               CharacterSpacing="-0.4" LineHeight="1.08"
                               MaximumWidthRequest="640" HorizontalOptions="Start"
                               Text="Do controle cru ao acabado."
                               motion:Motion.Entrance="True" />
                        <Label Style="{StaticResource BodyMuted}" FontSize="17" MaximumWidthRequest="540" HorizontalOptions="Start"
                               Text="Componentes .NET MAUI em até quatro níveis, lado a lado, com as decisões de design e o código para copiar."
                               motion:Motion.Entrance="True" motion:Motion.Delay="90" />
                        <HorizontalStackLayout Spacing="12" Margin="0,8,0,0"
                                               motion:Motion.Entrance="True" motion:Motion.Delay="160">
                            <Button Text="Explorar o catálogo" Style="{StaticResource PrimaryButtonLarge}"
                                    Command="{Binding OpenCatalogCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Produto real em vez de ilustração: o mesmo Switch nos três níveis, ao vivo -->
                <VerticalStackLayout Spacing="16" motion:Motion.Entrance="True" motion:Motion.Delay="300">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource SectionHeader}" Text="O mesmo controle, três níveis" />
                        <Label Style="{StaticResource BodySmall}" Text="Toque nos alternadores: todos funcionam." />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="{adaptive:OnWidth Compact='*', Default='*,*,*'}"
                              RowDefinitions="{adaptive:OnWidth Compact='Auto,Auto,Auto', Default='Auto'}">

                            <VerticalStackLayout Padding="28,24" Spacing="16">
                                <lib:OriginBadge Kind="Base" />
                                <!-- Faixa de altura fixa: os três alternadores têm alturas diferentes e precisam ficar na mesma linha -->
                                <Grid HeightRequest="40"><Switch HorizontalOptions="Start" VerticalOptions="Center" IsToggled="True" /></Grid>
                                <Label Style="{StaticResource Caption}" Text="Visual da plataforma, sem tokens." />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="{adaptive:OnWidth Compact=0, Default=1}" Grid.Row="{adaptive:OnWidth Compact=1, Default=0}"
                                                 Padding="28,24" Spacing="16">
                                <lib:OriginBadge Kind="Styled" />
                                <Grid HeightRequest="40"><Switch Style="{StaticResource VaultSwitch}" HorizontalOptions="Start" VerticalOptions="Center" IsToggled="True" /></Grid>
                                <Label Style="{StaticResource Caption}" Text="Cor de destaque do design system." />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="{adaptive:OnWidth Compact=0, Default=2}" Grid.Row="{adaptive:OnWidth Compact=2, Default=0}"
                                                 Padding="28,24" Spacing="16">
                                <lib:OriginBadge Kind="Custom" />
                                <Grid HeightRequest="40"><lib:VaultToggle HorizontalOptions="Start" VerticalOptions="Center" IsToggled="True" /></Grid>
                                <Label Style="{StaticResource Caption}" Text="Desenhado com Microsoft.Maui.Graphics." />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Recentes (RF09) -->
                <VerticalStackLayout Spacing="16" motion:Motion.Entrance="True" motion:Motion.Delay="380">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionHeader}" Text="Adicionados recentemente" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Ver todos" Style="{StaticResource TertiaryButton}"
                                Command="{Binding OpenCatalogCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComponentCardModel">
                                    <VerticalStackLayout>
                                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto"
                                              motion:Motion.Press="True" controls:Hero.Source="True"
                                              SemanticProperties.Description="{Binding Name}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenComponentCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <controls:ComponentThumb WidthRequest="40" HeightRequest="40" IconName="{Binding Icon}" controls:Hero.Key="thumb" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Style="{StaticResource CardTitle}" Text="{Binding Name}" controls:Hero.Key="title" />
                                                    <Label Text="Novo" FontFamily="{StaticResource FontMedium}" FontSize="13"
                                                           TextColor="{DynamicResource AccentText}"
                                                           IsVisible="{Binding IsNew}" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Style="{StaticResource BodySmall}" Text="{Binding Summary}"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                                <Label Style="{StaticResource Caption}" Text="{Binding VariantCountText}" VerticalOptions="Center" />
                                                <Label Style="{StaticResource Caption}" Text="›" FontSize="20" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView Style="{StaticResource Divider}" Margin="70,0,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Legenda dos níveis -->
                <VerticalStackLayout Spacing="16" Margin="0,0,0,32" motion:Motion.Entrance="True" motion:Motion.Delay="440">
                    <Label Style="{StaticResource SectionHeader}" Text="Como ler os níveis" />
                    <Grid ColumnDefinitions="{adaptive:OnWidth Compact='*', Default='*,*'}" ColumnSpacing="32" RowSpacing="18"
                          RowDefinitions="{adaptive:OnWidth Compact='Auto,Auto,Auto,Auto', Default='Auto,Auto'}">
                        <VerticalStackLayout Spacing="6">
                            <lib:OriginBadge Kind="{Binding Tiers[0].Tier, Converter={StaticResource TierBadge}}" Text="{Binding Tiers[0].Title}" />
                            <Label Style="{StaticResource BodySmall}" Text="{Binding Tiers[0].Description}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="{adaptive:OnWidth Compact=0, Default=1}" Grid.Row="{adaptive:OnWidth Compact=1, Default=0}" Spacing="6">
                            <lib:OriginBadge Kind="{Binding Tiers[1].Tier, Converter={StaticResource TierBadge}}" Text="{Binding Tiers[1].Title}" />
                            <Label Style="{StaticResource BodySmall}" Text="{Binding Tiers[1].Description}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="{adaptive:OnWidth Compact=2, Default=1}" Spacing="6">
                            <lib:OriginBadge Kind="{Binding Tiers[2].Tier, Converter={StaticResource TierBadge}}" Text="{Binding Tiers[2].Title}" />
                            <Label Style="{StaticResource BodySmall}" Text="{Binding Tiers[2].Description}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="{adaptive:OnWidth Compact=0, Default=1}" Grid.Row="{adaptive:OnWidth Compact=3, Default=1}" Spacing="6">
                            <lib:OriginBadge Kind="{Binding Tiers[3].Tier, Converter={StaticResource TierBadge}}" Text="{Binding Tiers[3].Title}" />
                            <Label Style="{StaticResource BodySmall}" Text="{Binding Tiers[3].Description}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
