<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:adaptive="clr-namespace:ComponentVault.Lib.Theming;assembly=ComponentVault.Lib"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ComponentVault.Core.ViewModels;assembly=ComponentVault.Core"
             xmlns:models="clr-namespace:ComponentVault.Core.Models;assembly=ComponentVault.Core"
             xmlns:controls="clr-namespace:ComponentVault.App.Controls"
             xmlns:lib="clr-namespace:ComponentVault.Lib.Controls;assembly=ComponentVault.Lib"
             xmlns:motion="clr-namespace:ComponentVault.Lib.Theming;assembly=ComponentVault.Lib"
             xmlns:mic="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             xmlns:fluent="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             x:Class="ComponentVault.App.Views.Detail.ComponentDetailPage"
             x:DataType="vm:ComponentDetailViewModel"
             Style="{StaticResource VaultPage}"
             Title="">

    <ContentPage.Resources>
        <controls:OriginToBadgeKindConverter x:Key="BadgeKind" />
        <controls:OriginToBrushConverter x:Key="OriginBrush" />
        <controls:TierToBrushConverter x:Key="TierBrush" />
        <controls:TierToBadgeKindConverter x:Key="TierBadge" />
    </ContentPage.Resources>

    <!-- O voltar é o da barra flutuante; o do Shell duplicaria na barra de título do Windows. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*,Auto" Padding="{DynamicResource TitleBarInset}">
        <!-- Luz ambiente (tema Vidro) atrás de tudo -->
        <lib:AmbientBackground Grid.RowSpan="3" Margin="{DynamicResource TitleBarBleed}" />

        <!-- Voltar, seções e tema; some no modo apresentação -->
        <controls:NavDock Grid.Row="{adaptive:OnWidth Compact=2, Default=0}" ShowBack="True"
                          IsVisible="{Binding IsPresentationMode, Converter={toolkit:InvertedBoolConverter}}" />

        <Grid Grid.Row="1" RowDefinitions="Auto,*"
              IsVisible="{Binding IsPresentationMode, Converter={toolkit:InvertedBoolConverter}}">

        <!-- ===== Cabeçalho, níveis e abas (somem no modo apresentação) ===== -->
        <VerticalStackLayout Padding="{adaptive:OnWidth Compact='20,12,20,0', Default='40,12,40,0'}" Spacing="18"
                             MaximumWidthRequest="{StaticResource ContentMaxWidth}"
                             IsVisible="{Binding IsPresentationMode, Converter={toolkit:InvertedBoolConverter}}">

            <!-- Celular: voltar no canto superior esquerdo, onde se espera; a barra de baixo fica só com seções e tema. -->
            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="1"
                    Stroke="{DynamicResource ChromeStroke}" BackgroundColor="{DynamicResource Chrome}"
                    HorizontalOptions="Start" Margin="0,4,0,-4"
                    IsVisible="{adaptive:OnWidth Compact=True, Default=False}"
                    motion:Motion.Press="True" SemanticProperties.Description="Voltar">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <mic:MauiIcon Icon="{x:Static fluent:FluentIcons.ChevronLeft24}" IconSize="18"
                              IconColor="{DynamicResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Ícone e título vêm voando da linha tocada no catálogo (Hero) -->
            <!--
              No celular o Apresentar desce para baixo do texto: ao lado, ele espremia a coluna do título
              e nomes longos ("Segmented control") quebravam no meio da palavra.
            -->
            <Grid x:Name="Header" ColumnDefinitions="{adaptive:OnWidth Compact='Auto,*', Default='Auto,*,Auto'}"
                  RowDefinitions="{adaptive:OnWidth Compact='Auto,Auto', Default='Auto'}"
                  ColumnSpacing="16" RowSpacing="14">
                <controls:ComponentThumb WidthRequest="56" HeightRequest="56" IconSize="26"
                                         IconName="{Binding Component.Icon}" VerticalOptions="Start"
                                         controls:Hero.Key="thumb" />
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Style="{StaticResource PageTitle}" Text="{Binding Component.Name}"
                           HorizontalOptions="Start" controls:Hero.Key="title" />
                    <VerticalStackLayout Spacing="4" motion:Motion.Entrance="True" motion:Motion.Delay="140">
                        <Label Style="{StaticResource BodySmall}" Text="{Binding Component.Summary}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                    </VerticalStackLayout>
                    <Label Style="{StaticResource Body}" TextColor="{DynamicResource DangerText}"
                           Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
                <Button Grid.Column="{adaptive:OnWidth Compact=1, Default=2}" Grid.Row="{adaptive:OnWidth Compact=1, Default=0}"
                        Text="Apresentar" Style="{StaticResource SecondaryButtonSmall}"
                        motion:Motion.Entrance="True" motion:Motion.Delay="200"
                        HorizontalOptions="Start" VerticalOptions="Start" Command="{Binding TogglePresentationCommand}"
                        SemanticProperties.Hint="Mostra só o componente, sem a interface ao redor" />
            </Grid>

            <!--
              Seletor de nível: trilho segmentado com uma pílula só, que desliza até o nível escolhido
              (SlidingIndicator no code-behind). O peso do texto não muda na seleção, para a largura
              do item ficar estável e a pílula não tremer.
            -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        motion:Motion.Entrance="True" motion:Motion.Delay="220">
                <Border BackgroundColor="{DynamicResource SurfaceAlt}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="4" HorizontalOptions="Start">
                    <Grid>
                        <Border x:Name="TierPill" HeightRequest="40" WidthRequest="0" StrokeShape="RoundRectangle 20"
                                StrokeThickness="1" Stroke="{DynamicResource Hairline}"
                                BackgroundColor="{DynamicResource Surface}" />
                        <HorizontalStackLayout x:Name="TierRow" Spacing="4" BindableLayout.ItemsSource="{Binding Variants}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:VariantOption">
                                    <HorizontalStackLayout Padding="16,0" HeightRequest="40" Spacing="8"
                                                           BackgroundColor="Transparent"
                                                           motion:Motion.Press="True"
                                                           SemanticProperties.Description="{Binding Title, StringFormat='Nível {0}'}">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectVariantCommand, Source={RelativeSource AncestorType={x:Type vm:ComponentDetailViewModel}}, x:DataType=vm:ComponentDetailViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                                 Fill="{Binding Tier, Converter={StaticResource TierBrush}}" />
                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontMedium}" FontSize="14"
                                               VerticalOptions="Center" TextColor="{DynamicResource InkTertiary}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </ScrollView>

            <!--
              Abas Preview · Lado a lado · Docs · Código. O sublinhado é um só e desliza até a aba
              escolhida (SlidingIndicator no code-behind), como a pílula da barra flutuante.
              O peso do texto não muda na seleção: mudar a largura da aba faria o sublinhado tremer.
            -->
            <Grid RowDefinitions="Auto,Auto" motion:Motion.Entrance="True" motion:Motion.Delay="280">
                <HorizontalStackLayout x:Name="TabRow" Spacing="20">
                    <Label x:Name="PreviewTab" Text="Preview" Padding="4,12" FontFamily="{StaticResource FontMedium}" FontSize="15"
                           TextColor="{DynamicResource InkTertiary}" motion:Motion.Press="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:DetailTab.Preview}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsPreviewTab}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label x:Name="CompareTab" Text="Lado a lado" Padding="4,12" FontFamily="{StaticResource FontMedium}" FontSize="15"
                           TextColor="{DynamicResource InkTertiary}" IsVisible="{Binding CanCompare}" motion:Motion.Press="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:DetailTab.Compare}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsCompareTab}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label x:Name="DocsTab" Text="Docs" Padding="4,12" FontFamily="{StaticResource FontMedium}" FontSize="15"
                           TextColor="{DynamicResource InkTertiary}" motion:Motion.Press="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:DetailTab.Docs}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDocsTab}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label x:Name="CodeTab" Text="Código" Padding="4,12" FontFamily="{StaticResource FontMedium}" FontSize="15"
                           TextColor="{DynamicResource InkTertiary}" motion:Motion.Press="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:DetailTab.Code}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsCodeTab}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
                <BoxView Grid.Row="1" Style="{StaticResource Divider}" />
                <BoxView x:Name="TabUnderline" Grid.Row="1" HeightRequest="2" CornerRadius="1"
                         Color="{StaticResource Accent}" VerticalOptions="End" />
            </Grid>
        </VerticalStackLayout>

        <!-- ===== Preview (RF02) + decisões do nível ===== -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsPreviewTab}"
                    motion:Motion.Entrance="True" motion:Motion.Delay="340">
            <VerticalStackLayout Padding="{adaptive:OnWidth Compact='20,20,20,40', Default='40,28,40,48'}" Spacing="28"
                                 MaximumWidthRequest="{StaticResource ContentMaxWidth}">
                <Border Style="{StaticResource PreviewCanvas}" Padding="{adaptive:OnWidth Compact=20, Default=36}">
                    <controls:PreviewHost VariantId="{Binding SelectedVariant.Id}" />
                </Border>

                <Grid ColumnDefinitions="{adaptive:OnWidth Compact='*', Default='*,*'}" ColumnSpacing="40" RowSpacing="24"
                      RowDefinitions="{adaptive:OnWidth Compact='Auto,Auto', Default='Auto'}"
                      IsVisible="{Binding IsPresentationMode, Converter={toolkit:InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="Sobre este nível" />
                        <Label Style="{StaticResource Body}" Text="{Binding SelectedVariant.Summary}" />
                        <Border Style="{StaticResource Tag}" HorizontalOptions="Start" Margin="0,4,0,0"
                                IsVisible="{Binding SelectedVariant.PackageId, Converter={toolkit:IsStringNotNullOrEmptyConverter}}">
                            <Label Style="{StaticResource TagText}" FontFamily="{StaticResource FontMono}"
                                   Text="{Binding SelectedVariant.PackageId}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="{adaptive:OnWidth Compact=0, Default=1}" Grid.Row="{adaptive:OnWidth Compact=1, Default=0}"
                                         Spacing="10" IsVisible="{Binding SelectedVariant.HasHighlights}">
                        <Label Style="{StaticResource FieldLabel}" Text="Decisões de design e usabilidade" />
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SelectedVariant.Highlights}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Path Data="M1 5L4.5 8.5L11 1.5" Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeLineJoin="Round"
                                              WidthRequest="12" HeightRequest="10" Aspect="Uniform" Margin="0,6,0,0" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Style="{StaticResource BodySmall}" Text="{Binding .}"
                                               TextColor="{DynamicResource Ink}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Lado a lado: todos os níveis ao vivo, para comparar o cru com o acabado ===== -->
        <!--
          Mesma coluna do cabeçalho (ContentMaxWidth, centralizada). Dois cards por linha no desktop:
          a largura de cada item é calculada no code-behind (OnCompareSizeChanged), porque a base
          percentual do FlexLayout não funciona no Windows. O espaço entre cards vem de Padding no
          item (o FlexLayout não conta Margin) e a margem negativa absorve o da última coluna.
        -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsCompareTab}">
            <VerticalStackLayout Padding="{adaptive:OnWidth Compact='20,20,20,40', Default='40,28,40,48'}"
                                 MaximumWidthRequest="{StaticResource ContentMaxWidth}">
            <FlexLayout x:Name="CompareFlex" Margin="0,0,-20,-20"
                        Direction="Row"
                        Wrap="Wrap" AlignItems="Start" AlignContent="Start" JustifyContent="Start"
                        SizeChanged="OnCompareSizeChanged"
                        ChildAdded="OnCompareChildAdded"
                        BindableLayout.ItemsSource="{Binding CompareVariants}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:VariantOption">
                        <Grid Padding="0,0,20,20">
                        <Border Style="{StaticResource PreviewCanvas}" Padding="0">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" Padding="22,16">
                                    <!-- O selo diz o nível com a cor dele; o título é o nome da variante. -->
                                    <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" VerticalOptions="Center" />
                                    <lib:OriginBadge Grid.Column="1" IsCompact="True" VerticalOptions="Center"
                                                     Kind="{Binding Tier, Converter={StaticResource TierBadge}}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider}" />
                                <controls:PreviewHost VariantId="{Binding Id}" Margin="22,20,22,24" />
                            </VerticalStackLayout>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Docs (RF08) ===== -->
        <!-- Coluna do cabeçalho; dentro dela, o texto fica em 760px, a largura boa de leitura. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsDocsTab}">
            <VerticalStackLayout Padding="{adaptive:OnWidth Compact='20,24,20,40', Default='40,32,40,48'}"
                                 MaximumWidthRequest="{StaticResource ContentMaxWidth}">
            <VerticalStackLayout Spacing="32" MaximumWidthRequest="760" HorizontalOptions="Start">
                <Label Style="{StaticResource Body}" FontSize="17" Text="{Binding Docs.Overview}" />

                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionHeader}" Text="Propriedades principais" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Docs.Properties}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DocProperty">
                                    <VerticalStackLayout>
                                        <VerticalStackLayout Padding="18,14" Spacing="4">
                                            <Label Style="{StaticResource CodeText}" Text="{Binding Name}"
                                                   TextColor="{DynamicResource SyntaxElement}" />
                                            <Label Style="{StaticResource BodySmall}" Text="{Binding Description}" />
                                        </VerticalStackLayout>
                                        <BoxView Style="{StaticResource Divider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionHeader}" Text="Quando usar" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Docs.UseCases}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Style="{StaticResource Body}" Text="{Binding ., StringFormat='—  {0}'}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionHeader}" Text="Limitações conhecidas" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Docs.Limitations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Style="{StaticResource BodyMuted}" Text="{Binding ., StringFormat='—  {0}'}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Código (RF03) ===== -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsCodeTab}">
            <VerticalStackLayout Padding="{adaptive:OnWidth Compact='20,24,20,40', Default='40,32,40,48'}" Spacing="20"
                                 MaximumWidthRequest="{StaticResource ContentMaxWidth}"
                                 BindableLayout.ItemsSource="{Binding SnippetModels}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CodeSnippetModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="18,10,12,10">
                                    <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource Tag}" VerticalOptions="Center">
                                        <Label Style="{StaticResource TagText}" Text="{Binding LanguageText}" />
                                    </Border>
                                    <Button Grid.Column="2" Text="Copiar" Style="{StaticResource SecondaryButtonSmall}"
                                            IsEnabled="{Binding IsMissing, Converter={toolkit:InvertedBoolConverter}}"
                                            Command="{Binding CopySnippetCommand, Source={RelativeSource AncestorType={x:Type vm:ComponentDetailViewModel}}, x:DataType=vm:ComponentDetailViewModel}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{Binding Title, StringFormat='Copiar {0}'}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider}" />
                                <ScrollView Orientation="Horizontal" BackgroundColor="{DynamicResource SurfaceAlt}">
                                    <controls:CodeView Style="{StaticResource CodeText}" Padding="18,16"
                                                       Tokens="{Binding Tokens}" FallbackText="{Binding Code}" />
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Aviso de cópia: pílula em tinta, some sozinho em 2s (ADR-007) -->
        <Border Grid.Row="1" Margin="16,0,16,28" Padding="18,12"
                HorizontalOptions="Center" VerticalOptions="End"
                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                BackgroundColor="{DynamicResource Ink}"
                IsVisible="{Binding HasCopyFeedback}">
            <Label Text="{Binding CopyFeedback}" FontFamily="{StaticResource FontMedium}" FontSize="14"
                   TextColor="{DynamicResource OnInk}" />
        </Border>

    </Grid>

        <!--
          ===== Modo Apresentar (RF10) =====
          Só o componente, centralizado, sobre o fundo. Troca de nível pelo controle embaixo,
          pelas setas do teclado ou deslizando para os lados fora do componente; Esc sai.
          No Windows a janela vai para tela cheia (code-behind).
        -->
        <Grid Grid.RowSpan="3" RowDefinitions="Auto,*,Auto" Padding="{adaptive:OnWidth Compact='16,20', Default='40,28'}"
              IsVisible="{Binding IsPresentationMode}">

            <!-- Área de gesto: atrás do componente, para não brigar com o que ele faz ao toque -->
            <BoxView Grid.RowSpan="3" Color="Transparent">
                <BoxView.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Left" Command="{Binding NextVariantCommand}" />
                    <SwipeGestureRecognizer Direction="Right" Command="{Binding PreviousVariantCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Qual componente e qual nível -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" InputTransparent="True">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                             Fill="{Binding SelectedVariant.Tier, Converter={StaticResource TierBrush}}" />
                    <Label Style="{StaticResource CardTitle}" FontSize="20" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Component.Name}" />
                                <Span Text="  ·  " TextColor="{DynamicResource InkTertiary}" />
                                <Span Text="{Binding SelectedVariant.Title}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
                <Label Style="{StaticResource Caption}" Text="{Binding PositionText}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- O componente -->
            <Border Grid.Row="1" Style="{StaticResource PreviewCanvas}"
                    MaximumWidthRequest="760" VerticalOptions="Center" Margin="0,24"
                    Padding="{adaptive:OnWidth Compact=24, Default=48}">
                <controls:PreviewHost VariantId="{Binding SelectedVariant.Id}" />
            </Border>

            <!-- Controle: anterior · pontos dos níveis · próximo | sair -->
            <VerticalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center">
                <Border BackgroundColor="{DynamicResource Chrome}" Stroke="{DynamicResource ChromeStroke}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="5" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.22" Radius="30" Offset="0,10" />
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="2">
                        <Grid WidthRequest="40" HeightRequest="40" motion:Motion.Press="True"
                              ToolTipProperties.Text="Nível anterior (←)" SemanticProperties.Description="Nível anterior">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousVariantCommand}" />
                            </Grid.GestureRecognizers>
                            <mic:MauiIcon Icon="{x:Static fluent:FluentIcons.ChevronLeft24}" IconSize="18"
                                          IconColor="{DynamicResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <HorizontalStackLayout Spacing="6" Padding="8,0" VerticalOptions="Center"
                                               BindableLayout.ItemsSource="{Binding Variants}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:VariantOption">
                                    <Border HeightRequest="8" WidthRequest="8" StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            BackgroundColor="{DynamicResource HairlineStrong}" VerticalOptions="Center"
                                            SemanticProperties.Description="{Binding Title, StringFormat='Nível {0}'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectVariantCommand, Source={RelativeSource AncestorType={x:Type vm:ComponentDetailViewModel}}, x:DataType=vm:ComponentDetailViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="WidthRequest" Value="24" />
                                                <Setter Property="BackgroundColor" Value="{DynamicResource Ink}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <Grid WidthRequest="40" HeightRequest="40" motion:Motion.Press="True"
                              ToolTipProperties.Text="Próximo nível (→)" SemanticProperties.Description="Próximo nível">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextVariantCommand}" />
                            </Grid.GestureRecognizers>
                            <mic:MauiIcon Icon="{x:Static fluent:FluentIcons.ChevronRight24}" IconSize="18"
                                          IconColor="{DynamicResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <BoxView WidthRequest="1" HeightRequest="20" Margin="6,0" Color="{DynamicResource ChromeStroke}"
                                 VerticalOptions="Center" />

                        <!-- Botão de verdade: recebe o foco ao entrar, e é por ele que as teclas chegam no Windows -->
                        <Button x:Name="ExitPresentationButton" Text="✕  Sair" Command="{Binding ExitPresentationCommand}"
                                HeightRequest="40" Padding="14,0" CornerRadius="20" BorderWidth="0"
                                BackgroundColor="Transparent" TextColor="{DynamicResource Ink}"
                                FontFamily="{StaticResource FontMedium}" FontSize="14"
                                ToolTipProperties.Text="Sair da apresentação (Esc)"
                                SemanticProperties.Description="Sair da apresentação" />                    </HorizontalStackLayout>
                </Border>

                <Label Style="{StaticResource Caption}" HorizontalOptions="Center" InputTransparent="True"
                       Text="← → trocam o nível  ·  Esc sai"
                       IsVisible="{adaptive:OnWidth Compact=False, Default=True}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
